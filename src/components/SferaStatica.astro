---
// La sfera come appare ferma nelle tavole (anelli puntinati e sfera a punti).
// Segnaposto: la sfera vera, in canvas, arriva al passo 3.
interface Props {
  misura?: number; // diametro dell'anello esterno, in px
}
const { misura = 540 } = Astro.props;
---

<div class="sfera" style={`--d: ${misura}px`} aria-hidden="true">
  <div class="anello a1">
    <div class="anello a2">
      <div class="palla">
        <div class="onda"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .sfera {
    width: min(var(--d), 100%);
    aspect-ratio: 1;
  }
  .anello,
  .palla,
  .onda {
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .a1 {
    width: 100%;
    height: 100%;
    border: 2px dotted #1f5a61;
  }
  .a2 {
    width: 91%;
    height: 91%;
    border: 2px dotted #2c7c84;
  }
  .palla {
    width: 89.4%;
    height: 89.4%;
    background-color: #14292c;
    background-image: radial-gradient(circle, var(--punti) 2.6px, transparent 3.2px);
    background-size: 16px 16px;
    box-shadow: var(--ombra-sfera);
  }
  .onda {
    width: 68%;
    height: 68%;
    border: 3px dotted var(--onda);
  }
  @media (max-width: 720px) {
    .palla {
      background-image: radial-gradient(circle, var(--punti) 2px, transparent 2.6px);
      background-size: 12px 12px;
      box-shadow: inset -36px -42px 72px #0b1112, inset 18px 18px 48px #2f6a71;
    }
  }
</style>
