---
// Testata di una pagina progetto (tavole Progetto*).
import Testata from './Testata.astro';
import Stato from './Stato.astro';
import Segno from './Segno.astro';
import type { Progetto, Collaboratore } from '../cms';

interface Props {
  progetto: Progetto;
  titolo: string; // la frase in Doto
  fase?: string; // es. "Alpha", accanto allo stato
  collaboratori?: Collaboratore[]; // la riga «Con Nome Cognome e Nome Cognome»
  link?: string; // il sito del progetto, quando è online
}
const { progetto, titolo, fase, collaboratori = [], link } = Astro.props;
// Tra gli ultimi due nomi «e» (o «ed» davanti a vocale), tra gli altri la virgola.
const separatore = (i: number) => {
  if (i === 0) return '';
  if (i < collaboratori.length - 1) return ', ';
  return /^[aeiou]/i.test(collaboratori[i].nome) ? ' ed ' : ' e ';
};
---

<Testata titolo={titolo}>
  <Fragment slot="etichetta">
    <a class="etichetta torna" href="/#progetti"><Segno /><span class="etichetta-nome">Progetti</span></a>
    <span class="stato-riga">
      <Stato stato={progetto.stato} focusabile />
      {fase && <span class="fase">· {fase}</span>}
    </span>
  </Fragment>
  <div class="identita">
    <span class="nome">
      {link ? <a class="link-punti" href={link}>{progetto.nome}</a> : progetto.nome}
      {progetto.provvisorio && <span class="provvisorio">(nome provvisorio)</span>}
    </span>
    <p class="attacco">{progetto.card}</p>
  </div>
  {
    collaboratori.length > 0 && (
      <span class="credito">
        Con{' '}
        {collaboratori.map((c, i) => (
          <Fragment>
            {separatore(i)}
            {c.link ? <a class="link-punti" href={c.link}>{c.nome}</a> : c.nome}
          </Fragment>
        ))}
      </span>
    )
  }
</Testata>

<style>
  .torna {
    text-decoration: none;
  }
  .torna:hover {
    color: var(--inchiostro);
  }
  .stato-riga {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .stato-riga :global(.stato) {
    font-size: var(--testo-etichetta);
  }
  .fase {
    font-family: var(--font-mono);
    font-size: var(--testo-etichetta);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .identita {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .nome {
    font-size: var(--testo-titolo);
    font-weight: 600;
    letter-spacing: -0.5px;
  }
  .provvisorio {
    margin-left: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .attacco {
    margin: 0;
    max-width: 680px;
    font-size: var(--testo-attacco);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.5px;
    color: var(--inchiostro-corpo);
  }
  .credito {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  @media (max-width: 720px) {
    .stato-riga :global(.stato),
    .fase {
      font-size: var(--testo-etichetta);
    }
    .nome {
      font-size: var(--testo-titolo);
    }
    .provvisorio {
      display: block;
      margin: var(--space-2) 0 0;
      font-size: var(--testo-meta);
    }
    .attacco {
      font-size: var(--testo-attacco);
      line-height: 1.35;
    }
    .credito {
      font-size: var(--testo-meta);
    }
  }
</style>
