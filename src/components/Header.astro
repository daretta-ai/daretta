---
// Header, dalle tavole Main/ChiSono (desktop) e *-Mobile (mobile).
// In home il logotipo compare solo quando la hero esce dallo schermo.
interface Props {
  attiva?: 'scritti' | 'progetti' | 'chi-sono';
  home?: boolean;
  avanzamento?: boolean; // negli articoli: la barra di lettura a punti sotto l'header
}
const { attiva, home = false, avanzamento = false } = Astro.props;
const PUNTI = 72;

// Non c'è una pagina indice dei progetti nelle tavole: PROGETTI porta al blocco in home.
// Curiosità non sta nel menu (decisione di Patrizio, 2 ott 2026): ci si arriva da «Vedi tutte» e dal footer.
const voci = [
  { id: 'scritti', etichetta: 'Scritti', href: '/scritti' },
  { id: 'progetti', etichetta: 'Progetti', href: '/#progetti' },
  { id: 'chi-sono', etichetta: 'Chi sono', href: '/chi-sono' },
] as const;
---

<header class:list={['header', { 'in-home': home, 'con-avanzamento': avanzamento }]}>
  <a class="logo" href="/" aria-label="dàretta, home">d<span>à</span>retta</a>

  <!-- Su mobile il menu copre tutta la pagina (scelta di Patrizio, 10 ott 2026): numeri delle voci e piede si vedono solo lì -->
  <nav class="menu" id="menu" aria-label="Principale">
    <ul>
      {voci.map((v, i) => (
        <li style={`--i: ${i}`}>
          <a href={v.href} aria-current={attiva === v.id ? 'page' : undefined}>
            <span class="numero" aria-hidden="true">[ {String(i + 1).padStart(2, '0')} ]</span>
            <span class="testo">{v.etichetta}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="menu-piede" style={`--i: ${voci.length}`}>
      <a href="https://www.linkedin.com/in/patriziobartolozzi" rel="me noopener">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href="mailto:dimmipure@daretta.it">Mail</a>
    </p>
  </nav>

  <div class="azioni">
    <a class="cta smussato" href="/#newsletter">Iscriviti</a>
    <button class="panino smussato" type="button" aria-controls="menu" aria-expanded="false" aria-label="Apri il menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <line class="l1" x1="3" y1="7" x2="17" y2="7"></line>
        <line class="l2" x1="3" y1="13" x2="17" y2="13"></line>
      </svg>
    </button>
  </div>

  {
    avanzamento && (
      <div class="avanzamento" role="progressbar" aria-label="Avanzamento della lettura" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-avanzamento>
        {Array.from({ length: PUNTI }, () => <span />)}
      </div>
    )
  }
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  if (header) {
    // Logotipo nascosto finché la hero è in vista (solo home)
    const hero = document.querySelector('[data-hero]');
    if (header.classList.contains('in-home') && hero) {
      header.classList.add('senza-logo');
      new IntersectionObserver(([e]) => header.classList.toggle('senza-logo', e.isIntersecting), {
        rootMargin: '-80px 0px 0px 0px',
      }).observe(hero);
    }
    // Negli articoli: i punti letti si accendono di arancio
    const barra = header.querySelector<HTMLElement>('[data-avanzamento]');
    const articolo = document.querySelector<HTMLElement>('[data-articolo]');
    if (barra && articolo) {
      const punti = [...barra.children];
      const aggiorna = () => {
        const r = articolo.getBoundingClientRect();
        const totale = r.height - innerHeight;
        const quota = totale > 0 ? Math.min(1, Math.max(0, -r.top / totale)) : 1;
        const accesi = Math.round(quota * punti.length);
        punti.forEach((p, i) => p.classList.toggle('letto', i < accesi));
        barra.setAttribute('aria-valuenow', String(Math.round(quota * 100)));
      };
      aggiorna();
      addEventListener('scroll', aggiorna, { passive: true });
      addEventListener('resize', aggiorna);
    }

    // Fondo dell'header solo quando la pagina scorre
    const segna = () => header.classList.toggle('staccato', scrollY > 8);
    segna();
    addEventListener('scroll', segna, { passive: true });

    // Menu mobile
    const bottone = header.querySelector<HTMLButtonElement>('.panino');
    // Con il menu aperto la pagina sotto non scorre
    const blocca = (si: boolean) => document.documentElement.classList.toggle('menu-aperto', si);
    const chiudi = () => {
      header.classList.remove('aperto');
      blocca(false);
      bottone?.setAttribute('aria-expanded', 'false');
      bottone?.setAttribute('aria-label', 'Apri il menu');
    };
    bottone?.addEventListener('click', () => {
      const aperto = header.classList.toggle('aperto');
      blocca(aperto);
      bottone.setAttribute('aria-expanded', String(aperto));
      bottone.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
      // Il menu viene prima del bottone nella pagina: senza questo, con Tab si finirebbe nel contenuto
      if (aperto) header.querySelector<HTMLAnchorElement>('.menu a')?.focus();
    });
    header.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', chiudi));
    // Se lo schermo si allarga oltre il mobile, il menu a tutto schermo non ha più senso
    matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && chiudi());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('aperto')) {
        chiudi();
        bottone?.focus();
      }
    });
    // Se il focus esce dal menu aperto (Tab oltre l'ultima voce e il bottone), il menu si chiude
    header.addEventListener('focusout', (e) => {
      if (header.classList.contains('aperto') && !header.contains(e.relatedTarget as Node | null)) chiudi();
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 48px;
    margin: 0 calc(var(--margine) * -1);
    padding: var(--space-6) calc(var(--margine) + var(--space-2)) var(--space-4);
    transition: background-color 0.2s;
  }
  .con-avanzamento {
    flex-wrap: wrap;
    row-gap: var(--space-3);
  }
  .avanzamento {
    flex-basis: 100%;
    order: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-2);
  }
  .avanzamento span {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-tondo);
    background: var(--filetto);
    transition: background-color 0.2s;
  }
  .avanzamento span:global(.letto) {
    background: var(--arancio);
  }
  .header.staccato {
    background: rgb(17 19 20 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .logo {
    font-family: var(--font-punti);
    font-weight: 900;
    font-size: 34px;
    line-height: 1;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .logo span {
    color: var(--arancio);
  }
  .senza-logo .logo {
    opacity: 0;
    visibility: hidden;
  }
  .menu {
    margin-left: auto;
  }
  .menu ul {
    display: flex;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu a,
  .cta {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu a {
    gap: var(--space-2);
    min-height: 44px;
  }
  .menu a:hover {
    color: var(--inchiostro-secondario);
  }
  .menu .numero,
  .menu-piede {
    display: none;
  }
  /* Pallino della voce attiva: uno dei pochi dettagli di stato in arancio */
  .menu a[aria-current]::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: var(--radius-tondo);
    background: var(--arancio);
  }
  .azioni {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .cta {
    height: 44px;
    padding: 0 20px;
    --h: 44px;
    --fondo: var(--arancio);
    color: var(--cemento);
  }
  /* Menu mobile: l'hamburger su un fondo smussato in filetto, senza contorno (scelta di Patrizio, 10 ott 2026). */
  .panino {
    display: none;
    width: 48px;
    height: 48px;
    --h: 48px;
    align-items: center;
    justify-content: center;
    --fondo: var(--filetto); /* cemento-rilievo non si vedeva sull'header trasparente */
    color: var(--inchiostro);
    cursor: pointer;
  }
  .panino line {
    transition: transform 0.2s;
    transform-origin: 10px 10px;
  }
  .aperto .l1 {
    transform: translateY(3px) rotate(45deg);
  }
  .aperto .l2 {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    /* Su mobile la metà dei punti: la barra resta leggibile */
    .avanzamento span:nth-child(even) {
      display: none;
    }
    .header {
      justify-content: space-between;
      padding: var(--space-4) calc(var(--margine) + var(--space-2)) var(--space-2);
    }
    .logo {
      font-size: 30px;
    }
    .cta {
      height: 48px;
      --h: 48px;
      padding: 0 18px;
      font-size: 13px;
    }
    .panino {
      display: inline-flex;
    }
    /* In home, finché la hero è in vista, su mobile resta solo il menu (tavola Home-Mobile) */
    .senza-logo .cta {
      visibility: hidden;
    }
    /* Menu a tutto schermo: sfuma dentro (320ms) e le voci salgono una dopo l'altra; esce sfumando (140ms) */
    .menu {
      position: fixed;
      inset: 0;
      z-index: -1;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 112px calc(var(--margine) + var(--space-2)) calc(var(--space-6) + env(safe-area-inset-bottom));
      overflow-y: auto;
      background: radial-gradient(130% 70% at 100% 0%, var(--petrolio-alone), var(--cemento) 72%);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 140ms ease-in,
        visibility 0s linear 140ms;
    }
    .aperto .menu {
      visibility: visible;
      opacity: 1;
      transition: opacity 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .menu li,
    .menu-piede {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 140ms ease-in,
        transform 140ms ease-in;
    }
    .aperto .menu li,
    .aperto .menu-piede {
      opacity: 1;
      transform: none;
      transition:
        opacity 320ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(80ms + var(--i) * 60ms),
        transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(80ms + var(--i) * 60ms);
    }
    .menu ul {
      flex-direction: column;
      gap: 0;
    }
    .menu li {
      border-top: 1px solid var(--filetto);
    }
    .menu li:last-child {
      border-bottom: 1px solid var(--filetto);
    }
    .menu a {
      width: 100%;
      min-height: 80px;
      gap: var(--space-4);
      font-family: var(--font-sans);
      font-size: 34px;
      font-weight: 500;
      letter-spacing: -0.5px;
      text-transform: none;
    }
    .menu .numero {
      display: inline;
      width: 56px;
      flex-shrink: 0;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 1px;
      color: var(--inchiostro-muto);
    }
    /* Il pallino della voce attiva va dopo la parola, come uno stato */
    .menu a[aria-current]::before {
      order: 2;
    }
    .menu-piede {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin: auto 0 0;
      padding-top: var(--space-8);
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--inchiostro-muto);
    }
    .menu-piede a {
      width: auto;
      min-height: 44px;
      font-family: inherit;
      font-size: inherit;
      font-weight: 400;
      letter-spacing: inherit;
      text-transform: inherit;
    }
    /* Con il menu aperto l'header non ha fondo né sfocatura (la sfocatura legherebbe il menu all'header) e il logotipo c'è sempre */
    .aperto.header {
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .aperto.senza-logo .logo,
    .aperto.senza-logo .cta {
      opacity: 1;
      visibility: visible;
    }
    :global(html.menu-aperto) {
      overflow: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu li,
    .menu-piede {
      transition: none !important;
    }
  }
</style>
