---
// Apertura dei testi da leggere (tavola Articolo): metadati nel margine, titolo in Geist nella colonna,
// la sfera piccola a destra, il filetto sotto. La usano gli articoli e i numeri della newsletter.
import Sfera from './Sfera.astro';
import { paragrafi } from '../cms';

interface Props {
  torna: { href: string; testo: string };
  tag?: string;
  data: Date;
  // «giorno» per gli articoli (9 ottobre 2026), «mese» per la newsletter (novembre 2026)
  formato?: 'giorno' | 'mese';
  minuti: number;
  titolo: string;
  attacco?: string;
}
const { torna, tag, data, formato = 'giorno', minuti, titolo, attacco } = Astro.props;
const quando = data.toLocaleDateString(
  'it-IT',
  formato === 'mese' ? { month: 'long', year: 'numeric' } : { day: 'numeric', month: 'long', year: 'numeric' }
);
---

<header class="griglia apertura">
  <div class="meta-margine">
    <a class="torna" href={torna.href}><span class="freccia freccia-indietro" aria-hidden="true">←</span> {torna.testo}</a>
    {tag && <span class="tag smussato contornato">{tag}</span>}
    <time datetime={data.toISOString().slice(0, formato === 'mese' ? 7 : 10)}>{quando}</time>
    <span>{minuti} min di lettura</span>
  </div>
  <div class="titoli">
    <h1>{titolo}</h1>
    {attacco && paragrafi(attacco).map((p) => <p class="attacco">{p}</p>)}
  </div>
  <div class="lato">
    <Sfera misura={150} />
  </div>
</header>

<hr class="filetto-apertura" />

<style>
  .apertura {
    align-items: start;
    padding: var(--space-18) var(--rientro) 0;
  }
  .meta-margine {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .torna {
    margin-bottom: var(--space-6);
    color: inherit;
    text-decoration: none;
  }
  .torna:hover {
    color: var(--inchiostro);
  }
  .tag {
    padding: var(--space-2) var(--space-3);
    --h: 28px;
    --fondo: var(--cemento);
    color: var(--inchiostro);
  }
  .titoli {
    grid-column: 4 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  h1 {
    margin: 0;
    font-size: var(--testo-articolo);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -2.5px;
    text-wrap: balance;
  }
  .attacco {
    margin: 0;
    font-size: var(--testo-attacco);
    line-height: 1.45;
    color: var(--inchiostro-corpo);
  }
  .lato {
    grid-column: span 3;
    display: flex;
    justify-content: flex-end;
  }
  .filetto-apertura {
    margin: var(--space-18) var(--rientro) 0;
    border: none;
    height: 1px;
    background: var(--filetto);
  }
  @media (max-width: 720px) {
    .apertura {
      padding-top: var(--space-8);
      gap: var(--space-6);
    }
    .meta-margine {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      padding-top: 0;
      font-size: var(--testo-meta);
    }
    .torna {
      flex-basis: 100%;
      margin-bottom: 0;
    }
    h1 {
      font-size: var(--testo-articolo);
      letter-spacing: -1px;
    }
    .attacco {
      font-size: var(--testo-attacco);
    }
    .lato {
      display: none;
    }
    .filetto-apertura {
      margin-top: var(--space-10);
    }
  }
</style>
