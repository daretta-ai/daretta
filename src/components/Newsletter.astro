---
// Modulo newsletter, l'unico in petrolio pieno (tavole Main, ChiSono, Progetto).
// Il collegamento a Kit arriva al passo 6: per ora il modulo non invia.
import Modulo from './Modulo.astro';
import { getNewsletter, paragrafi } from '../cms';

const nl = await getNewsletter();

interface Props {
  etichetta?: boolean;
  articolo?: boolean; // in fondo agli articoli: titolo e testo propri, niente etichetta
  class?: string;
}
const { etichetta = true, articolo = false, class: classe } = Astro.props;
const titolo = articolo ? nl.articoloTitolo : nl.titolo;
const testo = articolo ? nl.articoloTesto : nl.testo;
---

<Modulo as="form" luce="pieno" id="newsletter" class:list={['newsletter', classe]} aria-labelledby="newsletter-titolo" data-newsletter>
  {etichetta && !articolo && <span class="etichetta etichetta-nl">[ 006 ] Newsletter</span>}
  <h2 class="punti-titolo" id="newsletter-titolo">{titolo}</h2>
  {paragrafi(testo).map((p) => <p>{p}</p>)}
  <div class="riga">
    <label class="solo-lettori" for="newsletter-mail">La tua email</label>
    <span class="campo smussato"><input id="newsletter-mail" name="email" type="email" autocomplete="email" required placeholder={nl.segnaposto} /></span>
    <button class="smussato" type="submit">{nl.pulsante}</button>
  </div>
</Modulo>

<style>
  .newsletter {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }
  .etichetta-nl {
    color: var(--carta);
  }
  p {
    margin: 0;
    font-size: 20px;
    line-height: 1.45;
  }
  .riga {
    display: flex;
    gap: var(--space-3);
  }
  /* Il campo è smussato appena (smusso-campo), altrimenti sembra un pulsante.
     La forma sta sul contenitore: un input non ha ::before e ::after. */
  .campo {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    --s: var(--smusso-campo);
    --fondo: var(--carta);
    --anello: var(--carta);
  }
  input {
    flex-grow: 1;
    min-width: 0;
    height: 56px;
    padding: 0 var(--space-6);
    border: none;
    background: transparent;
    color: var(--cemento);
    font: inherit;
    font-size: 17px;
  }
  input::placeholder {
    color: #5c6466;
  }
  button {
    height: 56px;
    padding: 0 28px;
    --fondo: var(--arancio);
    --anello: var(--carta);
    color: var(--cemento);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .newsletter {
      gap: 14px;
    }
    /* Nella tavola mobile la newsletter non ha l'etichetta */
    .etichetta-nl {
      display: none;
    }
    p {
      font-size: 16px;
    }
    .riga {
      flex-direction: column;
    }
    input,
    button {
      height: 52px;
    }
    input {
      font-size: 16px;
      padding: 0 20px;
    }
  }
</style>
