---
// Modulo newsletter, l'unico in petrolio pieno (tavole Main, ChiSono, Progetto).
// Invia a /api/iscrizione, che passa l'email a Kit (passo 6). I messaggi di esito sono in Keystatic.
import Modulo from './Modulo.astro';
import { getNewsletter, paragrafi } from '../cms';

const nl = await getNewsletter();

interface Props {
  etichetta?: boolean;
  articolo?: boolean; // in fondo agli articoli: titolo e testo propri, niente etichetta
  class?: string;
}
const { etichetta = true, articolo = false, class: classe } = Astro.props;
const titolo = articolo ? nl.articoloTitolo : nl.titolo;
const testo = articolo ? nl.articoloTesto : nl.testo;
---

<Modulo
  as="form"
  luce="pieno"
  id="newsletter"
  class:list={['newsletter', classe]}
  aria-labelledby="newsletter-titolo"
  data-newsletter
  data-inviato={nl.inviato}
  data-gia-iscritto={nl.giaIscritto}
  data-mail-non-valida={nl.mailNonValida}
  data-errore={nl.errore}
  data-etichetta-inviato={nl.etichettaInviato}
  data-etichetta-gia-iscritto={nl.etichettaGiaIscritto}
  data-etichetta-mail-non-valida={nl.etichettaMailNonValida}
  data-etichetta-errore={nl.etichettaErrore}
  method="post"
  action="/api/iscrizione"
  novalidate
>
  {etichetta && !articolo && <span class="etichetta etichetta-sezione etichetta-nl"><span class="etichetta-numero">[ 006 ] </span><span class="etichetta-nome">Newsletter</span></span>}
  <h2 class="punti-titolo" id="newsletter-titolo">{titolo}</h2>
  {paragrafi(testo).map((p) => <p>{p}</p>)}
  <div class="riga">
    <label class="solo-lettori" for="newsletter-mail">La tua email</label>
    <span class="campo smussato"><input id="newsletter-mail" name="email" type="email" autocomplete="email" required placeholder={nl.segnaposto} aria-describedby="newsletter-esito" /></span>
    <button class="smussato" type="submit">{nl.pulsante}</button>
  </div>
  <!-- Trappola per i bot: nascosta a chi legge e a chi usa lo screen reader -->
  <input class="trappola" name="sito" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <!-- Il messaggio di esito: una striscia con etichetta e frase (design system, «I messaggi dei form»).
       Dopo l'iscrizione prende il posto del campo; dopo un errore sta sotto, e il campo resta. -->
  <div class="esito" id="newsletter-esito" role="status" tabindex="-1" data-esito hidden>
    <span class="esito-etichetta" data-esito-etichetta></span>
    <span class="esito-testo" data-esito-testo></span>
  </div>
  <a class="privacy" href="/privacy">{nl.privacy}</a>
</Modulo>

<script>
  // Un modulo per pagina di solito, ma negli articoli possono essercene due: si gestiscono tutti.
  for (const modulo of document.querySelectorAll<HTMLFormElement>('form[data-newsletter]')) {
    const campo = modulo.querySelector<HTMLInputElement>('input[name="email"]')!;
    const pulsante = modulo.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const esito = modulo.querySelector<HTMLElement>('[data-esito]')!;
    const etichetta = modulo.querySelector<HTMLElement>('[data-esito-etichetta]')!;
    const frase = modulo.querySelector<HTMLElement>('[data-esito-testo]')!;
    const riga = modulo.querySelector<HTMLElement>('.riga')!;
    const d = modulo.dataset;
    const messaggi: Record<string, [string, string]> = {
      inviato: [d.etichettaInviato ?? '', d.inviato ?? ''],
      'gia-iscritto': [d.etichettaGiaIscritto ?? '', d.giaIscritto ?? ''],
      'mail-non-valida': [d.etichettaMailNonValida ?? '', d.mailNonValida ?? ''],
      errore: [d.etichettaErrore ?? '', d.errore ?? ''],
    };
    // Iscrizione fatta (o già fatta): il form ha finito il suo lavoro e lascia il posto al messaggio.
    const conclusivi = new Set(['inviato', 'gia-iscritto']);
    const fermo = matchMedia('(prefers-reduced-motion: reduce)');
    const attendi = (ms: number) => new Promise((ok) => setTimeout(ok, fermo.matches ? 0 : ms));

    const nascondi = () => {
      esito.hidden = true;
      esito.classList.remove('entra');
      etichetta.textContent = '';
      frase.textContent = '';
    };
    const mostra = async (chiave: string) => {
      const [et, testo] = messaggi[chiave] ?? messaggi.errore;
      const conclusivo = conclusivi.has(chiave);
      // Gli errori si annunciano subito, il resto con calma
      esito.setAttribute('role', conclusivo ? 'status' : 'alert');
      esito.dataset.tipo = chiave;
      if (conclusivo) {
        // Il form sfuma via (140ms), poi arriva la striscia
        riga.classList.add('esce');
        await attendi(140);
        riga.hidden = true;
        campo.removeAttribute('aria-describedby');
      }
      etichetta.textContent = `[ ${et} ]`;
      frase.textContent = testo;
      esito.hidden = false;
      esito.classList.remove('entra');
      void esito.offsetWidth; // riparte l'animazione anche se il messaggio cambia
      esito.classList.add('entra');
      if (conclusivo) esito.focus({ preventScroll: true });
    };

    modulo.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      nascondi();
      if (!campo.checkValidity()) {
        mostra('mail-non-valida');
        campo.setAttribute('aria-invalid', 'true');
        campo.focus();
        return;
      }
      campo.removeAttribute('aria-invalid');
      pulsante.disabled = true;
      modulo.setAttribute('aria-busy', 'true');
      let chiave = 'errore';
      try {
        const r = await fetch('/api/iscrizione', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: campo.value, sito: (modulo.elements.namedItem('sito') as HTMLInputElement).value }),
        });
        chiave = ((await r.json()) as { esito?: string }).esito ?? 'errore';
      } catch {
        chiave = 'errore';
      }
      modulo.removeAttribute('aria-busy');
      pulsante.disabled = false;
      await mostra(chiave);
      if (!conclusivi.has(chiave)) {
        if (chiave === 'mail-non-valida') campo.setAttribute('aria-invalid', 'true');
        campo.focus();
      }
    });
  }
</script>

<style>
  .newsletter {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }
  /* Sul petrolio pieno onda non si legge: il titolo di sezione resta carta */
  .etichetta-nl {
    color: var(--carta);
  }
  p {
    margin: 0;
    font-size: 20px;
    line-height: 1.45;
  }
  .riga {
    display: flex;
    gap: var(--space-3);
  }
  .riga[hidden] {
    display: none;
  }
  .privacy {
    align-self: flex-start;
    color: var(--carta);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration-style: dotted;
    text-underline-offset: 4px;
  }
  /* La striscia del messaggio: smusso dei campi, petrolio scuro sopra il petrolio del modulo */
  .esito {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-height: 56px; /* quanto la riga del campo: il modulo non salta */
    padding: 14px var(--space-6);
    background: color-mix(in srgb, var(--petrolio-scuro) 60%, transparent);
    clip-path: var(--ritaglio-campo);
    color: var(--carta);
  }
  .esito[hidden] {
    display: none;
  }
  .esito:focus {
    outline: none; /* riceve il focus solo da script, per non lasciare la tastiera su un pulsante sparito */
  }
  .esito-etichetta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .esito-testo {
    font-size: 17px;
    line-height: 1.45;
  }
  .esito.entra {
    animation: esito-entra 320ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes esito-entra {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .riga.esce {
    opacity: 0;
    transition: opacity 140ms ease-in;
  }
  /* Email da correggere: l'anello del campo resta acceso anche senza focus */
  .campo:has([aria-invalid='true'])::after {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .esito.entra {
      animation: none;
    }
    .riga.esce {
      transition: none;
    }
  }
  .trappola {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  button:disabled {
    cursor: wait;
    opacity: 0.7;
  }
  /* Il campo è smussato appena (smusso-campo), altrimenti sembra un pulsante.
     La forma sta sul contenitore: un input non ha ::before e ::after. */
  .campo {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    --s: var(--smusso-campo);
    --fondo: var(--carta);
    --anello: var(--carta);
  }
  input {
    flex-grow: 1;
    min-width: 0;
    height: 56px;
    padding: 0 var(--space-6);
    border: none;
    background: transparent;
    color: var(--cemento);
    font: inherit;
    font-size: 17px;
  }
  input::placeholder {
    color: #5c6466;
  }
  button {
    height: 56px;
    --h: 56px;
    padding: 0 28px;
    --fondo: var(--arancio);
    --anello: var(--carta);
    color: var(--cemento);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .newsletter {
      gap: 14px;
    }
    /* Nella tavola mobile la newsletter non ha l'etichetta */
    .etichetta-nl {
      display: none;
    }
    p {
      font-size: 16px;
    }
    .riga {
      flex-direction: column;
    }
    input,
    button {
      height: 52px;
    }
    button {
      --h: 52px;
    }
    input {
      font-size: 16px;
      padding: 0 20px;
    }
    .esito {
      min-height: 52px;
      padding: 12px 20px;
    }
    .esito-testo {
      font-size: 16px;
    }
  }
</style>
