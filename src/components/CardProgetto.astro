---
// Card di un progetto, dentro il modulo Progetti (tavola Main).
import Stato from './Stato.astro';
import type { Progetto } from '../cms';

interface Props {
  progetto: Progetto;
}
const { progetto } = Astro.props;
---

<a class="card smussato" href={`/progetti/${progetto.slug}`}>
  <Stato stato={progetto.stato} />
  <span class="nome">
    <span class="titolo">{progetto.nome}</span>
    {progetto.provvisorio && <span class="provvisorio">(nome provvisorio)</span>}
  </span>
  <span class="descrizione">{progetto.card}</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 240px;
    padding: var(--space-8);
    --s: var(--card-smusso);
    --fondo: var(--cemento-incavo);
    text-decoration: none;
  }
  .card:hover {
    --fondo: #161a1b;
  }
  .nome {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .titolo {
    font-size: var(--testo-attacco);
    font-weight: 600;
    line-height: 1.25;
  }
  .provvisorio {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .descrizione {
    font-size: var(--testo-piccolo);
    line-height: 1.45;
    color: var(--inchiostro-secondario);
  }
  @media (max-width: 720px) {
    .card {
      min-height: 0;
      padding: var(--space-6);
    }
  }
</style>
