---
// Citazione o passaggio in evidenza: una frase in Doto (punti-motto) nella colonna del testo
// (4–9), allineata a sinistra come i paragrafi. La riga sotto è facoltativa:
// c'è quando le parole sono di qualcun altro (la fonte), manca quando è una frase del testo.
interface Props {
  testo: string;
  didascalia?: string;
}
const { testo, didascalia } = Astro.props;
---

<figure class="griglia citazione">
  <div class="fascia">
    <blockquote>
      <p class="frase">{testo}</p>
    </blockquote>
    {didascalia && <figcaption class="didascalia">— {didascalia}</figcaption>}
  </div>
</figure>

<style>
  .citazione {
    margin: 0;
    /* 72px sopra; sotto 32, che col blocco di testo che segue (40) torna a 72 */
    padding: var(--space-18) var(--rientro) var(--space-8);
  }
  .fascia {
    grid-column: 4 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  blockquote {
    margin: 0;
  }
  .frase {
    margin: 0;
    font-family: var(--font-punti);
    font-weight: 900;
    font-size: 48px;
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--inchiostro);
    text-wrap: pretty;
  }
  .didascalia {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  @media (max-width: 720px) {
    .citazione {
      /* 40 sopra; sotto 8, che col testo che segue (32 su mobile) torna a 40 */
      padding-top: var(--space-10);
      padding-bottom: var(--space-2);
    }
    .frase {
      font-size: 34px;
    }
  }
</style>
