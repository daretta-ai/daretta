---
// Modulo con un numero vero in evidenza: etichetta nel margine (colonne 1–3), testo accanto (4–8),
// numero a destra (9–12) in punti-numero: numero e didascalia centrati nelle colonne 9–12, in alto come il testo, con la luce che parte da lui.
// Su mobile: etichetta, numero, testo.
// Tavole: Chi sono (1/10), valdinievole (11), Skill Bloom (5), BalillaLand (30%).
import Modulo from './Modulo.astro';
import Sezione from './Sezione.astro';

interface Props {
  etichetta: string;
  cifra: string;
  didascalia: string;
}
const { etichetta, cifra, didascalia } = Astro.props;
---

<Modulo luce="media" class="griglia modulo-numero">
  <Sezione segno class="margine">{etichetta}</Sezione>
  <div class="oggetto">
    <span class="cifra">{cifra}</span>
    <span class="didascalia">{didascalia}</span>
  </div>
  <div class="testo">
    <slot />
  </div>
</Modulo>

<style>
  .modulo-numero {
    margin-top: var(--space-14);
    align-items: start;
  }
  /* Su desktop il box sborda di --sbordo oltre il filo dei contenuti e dentro rientra di --sbordo + 8px:
     le sue colonne coincidono con quelle del testo, l'etichetta sta sulla linea delle altre
     e dal bordo del box c'è aria. */
  @media (min-width: 721px) {
    .modulo-numero.modulo-numero {
      margin-inline: calc(-1 * var(--sbordo));
      padding: var(--space-14) calc(var(--sbordo) + var(--space-2));
    }
    .modulo-numero :global(.margine) {
      grid-column: 1 / span 3;
      grid-row: 1;
      padding-top: var(--space-2);
    }
    .testo {
      grid-column: 4 / span 5;
      grid-row: 1;
    }
    .oggetto {
      grid-column: 9 / span 4;
      grid-row: 1;
      /* Numero e didascalia centrati nelle colonne 9–12, solo in orizzontale */
      align-items: center;
      text-align: center;
    }
  }
  .oggetto {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cifra {
    font-family: var(--font-punti);
    font-weight: 900;
    font-size: 168px;
    line-height: 0.85;
    letter-spacing: -6px;
  }
  .didascalia {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-corpo);
  }
  .testo {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .testo :global(p) {
    margin: 0;
    font-size: var(--testo-corpo);
    line-height: 1.7;
    color: var(--inchiostro-corpo);
  }
  @media (max-width: 720px) {
    .modulo-numero {
      margin-top: var(--space-8);
      gap: var(--space-4);
    }
    .cifra {
      font-size: 104px;
      letter-spacing: -4px;
    }
    .testo {
      margin-top: var(--space-2);
    }
    .testo :global(p) {
      font-size: var(--testo-corpo);
      line-height: 1.65;
    }
  }
</style>
