---
// Modulo-testata delle pagine interne (tavole ChiSono, Progetto*, Scritti, Curiosita, 404).
// Etichetta, titolo in Doto, frase d'attacco; su desktop a destra la sfera piccola.
import Modulo from './Modulo.astro';
import Sfera from './Sfera.astro';

interface Props {
  titolo: string;
  sfera?: boolean;
  compatta?: boolean; // testata bassa, senza altezza minima (Scritti, 404)
}
const { titolo, sfera = true, compatta = false } = Astro.props;
---

<Modulo luce="forte" class:list={['griglia', 'testata', { compatta }]}>
  <div class="testo">
    <div class="riga-etichetta"><slot name="etichetta" /></div>
    <h1 class="punti-pagina">{titolo}</h1>
    <slot />
  </div>
  {
    sfera && (
      <div class="lato">
        <Sfera misura={320} />
      </div>
    )
  }
</Modulo>

<style>
  .testata {
    min-height: 560px;
    align-items: center;
  }
  .compatta {
    min-height: 0;
  }
  .testo {
    grid-column: span 8;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .riga-etichetta {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    flex-wrap: wrap;
  }
  .lato {
    grid-column: span 4;
    display: flex;
    justify-content: center;
  }
  @media (max-width: 1100px) {
    .testo {
      grid-column: span 12;
    }
    .lato {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .testata {
      min-height: 0;
    }
    .testo {
      gap: var(--space-6);
    }
    .riga-etichetta {
      gap: var(--space-4);
    }
  }
</style>
