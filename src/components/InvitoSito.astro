---
// Invito al sito del progetto: etichetta nel margine (colonne 1–3), testo e pulsante (4–8),
// anteprime del sito a destra (9–12), il desktop e sopra il telefono, con la luce che parte da loro.
// Su mobile: etichetta, testo, anteprime, pulsante.
// Movimento (design system, «Il movimento»): le schede salgono di 12px quando entrano nello schermo,
// una volta sola; a entrata finita, con il mouse, si inclinano di pochi gradi verso il cursore e il
// telefono si stacca appena dal desktop. Mai il testo. Con prefers-reduced-motion resta tutto fermo.
// Le anteprime stanno in public/anteprime: <nome>-desktop-720/1080.webp e <nome>-mobile-240/390.webp.
import Modulo from './Modulo.astro';
import Sezione from './Sezione.astro';

interface Props {
  etichetta: string;
  meta?: string;
  pulsante?: string;
  anteprime: string;
  link?: string; // il sito del progetto, dal campo «Sito del progetto»
}
const { etichetta, meta, pulsante = 'Vai al sito', anteprime, link } = Astro.props;
const dominio = link ? new URL(link).hostname.replace(/^www\./, '') : undefined;
const base = `/anteprime/${anteprime}`;
const Anteprime = link ? 'a' : 'div';
---

<Modulo luce="media" class="griglia invito-sito">
  <Sezione segno class="margine">{etichetta}</Sezione>
  <div class="testo">
    {meta && <span class="meta">{meta}</span>}
    {dominio && <span class="nome">{dominio}</span>}
    <slot />
  </div>
  {
    link && (
      <a class="pulsante smussato contornato" href={link}>
        <span class="trama" aria-hidden="true"></span>
        {pulsante} <span class="freccia" aria-hidden="true">→</span>
      </a>
    )
  }
  <Anteprime class="anteprime" href={link} tabindex={link ? '-1' : undefined} aria-hidden="true" data-anteprime>
    <div class="piano">
      <div class="schermo">
        <img
          src={`${base}-desktop-720.webp`}
          srcset={`${base}-desktop-720.webp 720w, ${base}-desktop-1080.webp 1080w`}
          sizes="(max-width: 720px) 85vw, 360px"
          width="1280"
          height="800"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="telefono">
        <div class="schermo schermo-telefono">
          <div class="cornice">
            <img
              src={`${base}-mobile-240.webp`}
              srcset={`${base}-mobile-240.webp 240w, ${base}-mobile-390.webp 390w`}
              sizes="(max-width: 720px) 30vw, 110px"
              width="390"
              height="844"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </Anteprime>
</Modulo>

<script>
  // Entrata delle schede e inclinazione al passaggio del mouse.
  const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mouse = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const navigazione = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  const indietro = navigazione?.type === 'back_forward';

  for (const el of document.querySelectorAll<HTMLElement>('[data-anteprime]')) {
    const sotto = el.getBoundingClientRect().top > innerHeight;
    if (!ridotto && sotto && !location.hash && !indietro && 'IntersectionObserver' in window) {
      el.classList.add('in-attesa');
      const osserva = new IntersectionObserver(
        (voci) => {
          if (!voci.some((v) => v.isIntersecting)) return;
          osserva.disconnect();
          el.classList.add('entrate');
          // 320ms di corsa, il telefono parte 80ms dopo: da qui le schede sono ferme
          setTimeout(() => el.classList.add('ferme'), 420);
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      osserva.observe(el);
    } else {
      el.classList.add('ferme');
    }

    if (ridotto || !mouse) continue;
    el.addEventListener('pointermove', (e) => {
      if (!el.classList.contains('ferme')) return;
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      el.style.setProperty('--ruota-y', `${(x * 6).toFixed(2)}deg`);
      el.style.setProperty('--ruota-x', `${(-y * 4.8).toFixed(2)}deg`);
      el.classList.add('inclinate');
    });
    el.addEventListener('pointerleave', () => {
      el.style.setProperty('--ruota-y', '0deg');
      el.style.setProperty('--ruota-x', '0deg');
      el.classList.remove('inclinate');
    });
  }
</script>

<style>
  .invito-sito {
    margin-top: var(--space-14);
    align-items: start;
  }
  /* La luce parte dalle anteprime, a destra */
  .invito-sito.invito-sito {
    background: radial-gradient(620px 420px at 82% 50%, var(--petrolio-alone) 0%, var(--cemento-rilievo) 78%);
  }
  .testo {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .nome {
    font-size: var(--testo-titolo);
    font-weight: 500;
    letter-spacing: -0.5px;
    line-height: 1.2;
    color: var(--inchiostro);
  }
  .testo :global(p) {
    margin: 0;
    font-size: var(--testo-corpo);
    line-height: 1.7;
    color: var(--inchiostro-corpo);
  }

  /* Pulsante fantasma: l'arancio resta a Iscrivimi, nella newsletter subito sotto */
  .pulsante {
    --h: 56px;
    justify-self: start;
    min-height: 56px;
    padding: 0 var(--space-6);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--inchiostro);
    font-family: var(--font-mono);
    font-size: var(--testo-etichetta);
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
  }

  .anteprime {
    display: block;
    perspective: 1100px;
  }
  .piano {
    position: relative;
    /* spazio sotto il desktop per il telefono che sporge */
    padding-bottom: 12%;
    transform-style: preserve-3d;
    transform: rotateX(var(--ruota-x, 0deg)) rotateY(var(--ruota-y, 0deg));
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .schermo img {
    display: block;
    width: 100%;
    height: auto;
    clip-path: var(--ritaglio-card);
    background: #ffffff;
  }
  .telefono {
    position: absolute;
    right: calc(-1 * var(--space-2));
    bottom: 0;
    width: 28%;
    transform: translateZ(0);
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cornice {
    --s: 14px;
    padding: 4px;
    background: var(--cemento-rilievo);
    clip-path: polygon(0 var(--s), var(--s) 0, calc(100% - var(--s)) 0, 100% var(--s), 100% calc(100% - var(--s)), calc(100% - var(--s)) 100%, var(--s) 100%, 0 calc(100% - var(--s)));
  }
  .cornice img {
    --s: 12px;
    clip-path: polygon(0 var(--s), var(--s) 0, calc(100% - var(--s)) 0, 100% var(--s), 100% calc(100% - var(--s)), calc(100% - var(--s)) 100%, var(--s) 100%, 0 calc(100% - var(--s)));
  }

  /* Mentre il cursore è sopra, le schede lo seguono più svelte; il telefono si stacca di 12px */
  .inclinate .piano {
    transition-duration: 160ms;
  }
  .inclinate .telefono {
    transform: translateZ(12px);
    transition-duration: 160ms;
  }

  /* Entrata: senza JavaScript la classe non c'è e le schede sono già al loro posto */
  .in-attesa .schermo {
    opacity: 0;
    transform: translateY(12px);
  }
  .entrate .schermo {
    opacity: 1;
    transform: none;
    transition:
      opacity 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .entrate .schermo-telefono {
    transition-delay: 80ms;
  }

  @media (min-width: 721px) {
    /* Come il modulo con il numero: sborda oltre il filo dei contenuti, dentro lo stesso rientro dei blocchi */
    .invito-sito.invito-sito {
      margin-inline: calc(-1 * var(--sbordo));
      padding: var(--space-14) calc(var(--sbordo) + var(--space-2));
      row-gap: var(--space-8);
    }
    .invito-sito :global(.margine) {
      grid-column: 1 / span 3;
      grid-row: 1 / span 2;
      padding-top: var(--space-2);
    }
    .testo {
      grid-column: 4 / span 5;
      grid-row: 1;
    }
    .pulsante {
      grid-column: 4 / span 5;
      grid-row: 2;
    }
    .anteprime {
      grid-column: 9 / span 4;
      grid-row: 1 / span 2;
      padding-right: var(--space-8);
    }
  }

  @media (max-width: 720px) {
    .invito-sito {
      margin-top: var(--space-8);
      gap: var(--space-4);
      background: radial-gradient(360px 300px at 70% 62%, var(--petrolio-alone) 0%, var(--cemento-rilievo) 80%);
    }
    .testo {
      margin-top: var(--space-2);
    }
    .anteprime {
      margin-top: var(--space-4);
    }
    .telefono {
      width: 30%;
      right: 0;
    }
    .pulsante {
      --h: 52px;
      min-height: 52px;
      justify-self: stretch;
      justify-content: center;
      margin-top: var(--space-4);
      /* Su mobile il pulsante chiude il modulo, dopo le anteprime */
      order: 1;
      font-size: var(--testo-etichetta);
    }
  }
</style>
