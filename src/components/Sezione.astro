---
// Etichetta di sezione: [ ■ ] CHIACCHIERE, lo stesso segno degli elenchi puntati, in onda.
// Senza segno diventa un'etichetta semplice (es. IL PERCORSO), in inchiostro-muto.
// Il segno si apre quando l'etichetta entra nello schermo e all'hover le parentesi si stringono
// (movimento.css, script in Base.astro), come negli elenchi.
import Segno from './Segno.astro';

interface Props {
  segno?: boolean;
  as?: string;
  id?: string;
  class?: string;
}
const { segno = false, as: Tag = 'h2', id, class: classe } = Astro.props;
---

<Tag class:list={['etichetta', segno && ['etichetta-sezione', 'anima-segno'], classe]} id={id}>{segno && <Segno />}<span class="etichetta-nome"><slot /></span></Tag>
