---
// Etichetta di sezione: [ 003 ] SCRITTI in home, [ 01 ] ... dentro una pagina.
interface Props {
  numero: number;
  cifre?: 2 | 3;
  as?: 'h2' | 'h3' | 'p';
  id?: string;
}
const { numero, cifre = 3, as: Tag = 'h2', id } = Astro.props;
---

<Tag class="sezione" id={id}>[ {String(numero).padStart(cifre, '0')} ] <slot /></Tag>

<style>
  .sezione {
    margin: 0 0 var(--space-3);
    font-family: var(--mono);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
    white-space: pre;
  }
</style>
