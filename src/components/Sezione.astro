---
// Etichetta di sezione: [ 003 ] SCRITTI in home, [ 01 ] LA VERSIONE BREVE dentro una pagina.
// Senza numero diventa un'etichetta semplice (es. IL PERCORSO).
interface Props {
  numero?: number;
  cifre?: 2 | 3;
  as?: string;
  id?: string;
  class?: string;
}
const { numero, cifre = 3, as: Tag = 'h2', id, class: classe } = Astro.props;
---

<Tag class:list={['etichetta', numero !== undefined && 'etichetta-sezione', classe]} id={id}>{numero !== undefined && <span class="etichetta-numero">{`[ ${String(numero).padStart(cifre, '0')} ] `}</span>}<span class="etichetta-nome"><slot /></span></Tag>
