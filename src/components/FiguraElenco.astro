---
// Figura a elenco: voci separate da filetti, l'ultima in evidenza (tavola Progetto-Concorsi).
interface Props {
  didascalia: string;
  voci: string[];
  nota?: string;
}
const { didascalia, voci, nota } = Astro.props;
---

<figure class="figura-elenco">
  <figcaption>{didascalia}</figcaption>
  <ul>
    {
      voci.map((v, i) => (
        <li class:list={{ ultima: i === voci.length - 1 }}>
          <span class="pallino" aria-hidden="true" />
          {v}
        </li>
      ))
    }
  </ul>
  {nota && <span class="nota">{nota}</span>}
</figure>

<style>
  .figura-elenco {
    margin: 0;
    padding: var(--space-10);
    clip-path: var(--ritaglio-modulo);
    background: var(--cemento-rilievo);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  figcaption,
  .nota {
    font-family: var(--font-mono);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  figcaption {
    font-size: var(--testo-meta);
  }
  .nota {
    font-size: var(--testo-meta);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--filetto-neutro);
  }
  li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--filetto-neutro);
    font-size: var(--testo-corpo);
    color: var(--inchiostro-corpo);
  }
  li.ultima {
    color: var(--inchiostro);
  }
  .pallino {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    border-radius: var(--radius-tondo);
    background-color: var(--cemento-incavo);
    background-image: radial-gradient(circle, #3a9ca5 1.6px, transparent 2px);
    background-size: 5px 5px;
  }
  @media (max-width: 720px) {
    .figura-elenco {
      padding: var(--space-6);
      gap: var(--space-4);
    }
    li {
      font-size: var(--testo-corpo);
      padding: 14px 0;
    }
  }
</style>
