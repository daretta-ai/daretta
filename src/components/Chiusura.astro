---
// La fascia prima del footer, uguale in tutte le pagine (design system, «La chiusura»).
// Due mosse per chi è arrivato in fondo: proseguire (a sinistra, righe posate sul fondo)
// o restare in contatto (a destra, la newsletter, l'unico modulo della fascia).
// In home la stessa disposizione ha a sinistra il tabellone delle curiosità.
import Newsletter from './Newsletter.astro';
import type { Rimando } from '../rimandi';

interface Props {
  rimandi: Rimando[];
  articolo?: boolean; // in fondo agli articoli la newsletter ha titolo e testo propri
}
const { rimandi, articolo = false } = Astro.props;
---

<section class="griglia chiusura">
  <nav class="rimandi" aria-label="Prosegui">
    <ul>
      {
        rimandi.map((r) => (
          <li>
            <a href={r.href}>
              <span class="etichetta">
                {r.etichetta} <span class="freccia" aria-hidden="true">→</span>
              </span>
              <span class="titolo-lista testo-rimando">{r.testo}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="nl"><Newsletter articolo={articolo} /></div>
</section>

<style>
  .chiusura {
    margin-top: var(--stacco);
    align-items: start;
  }
  .rimandi {
    grid-column: 1 / span 5;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--filetto);
  }
  li {
    border-top: 1px solid var(--filetto);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-10) 0;
    text-decoration: none;
  }
  .testo-rimando {
    color: var(--inchiostro-corpo);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
    transition: text-decoration-color 0.2s;
  }
  a:hover .testo-rimando,
  a:focus-visible .testo-rimando {
    text-decoration-color: currentColor;
  }
  .nl {
    grid-column: 7 / span 6;
    display: flex;
  }
  .nl > :global(*) {
    flex: 1;
  }
  @media (max-width: 720px) {
    .chiusura {
      row-gap: var(--stacco);
    }
    .rimandi,
    .nl {
      grid-column: 1 / -1;
    }
    a {
      gap: var(--space-2);
      padding: var(--space-6) 0;
    }
  }
</style>
