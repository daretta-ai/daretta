---
// La fascia prima del footer, uguale in tutte le pagine (design system, «La chiusura»).
// Due mosse per chi è arrivato in fondo: proseguire (a sinistra, righe posate sul fondo)
// o restare in contatto (a destra, la newsletter, l'unico modulo della fascia).
// In home la stessa disposizione ha a sinistra il tabellone delle curiosità.
import Newsletter from './Newsletter.astro';
import type { Rimando } from '../rimandi';

// Una riga può essere un gruppo di alternative: se ne mostra una a caso (es. un progetto).
interface Props {
  rimandi: (Rimando | Rimando[])[];
  variante?: 'articolo' | 'progetto'; // la newsletter ha titolo e testo propri
}
const { rimandi, variante } = Astro.props;
// Ogni voce diventa un gruppo; nei gruppi da più righe, senza JavaScript resta visibile la prima.
const gruppi = rimandi.map((r) => (Array.isArray(r) ? r : [r]));
---

<section class="griglia chiusura">
  <nav class="rimandi" aria-label="Prosegui">
    <ul>
      {
        gruppi.flatMap((gruppo, g) =>
          gruppo.map((r, i) => (
          <li data-gruppo={gruppo.length > 1 ? g : undefined} hidden={i > 0}>
            <a class="principale" href={r.href}>
              <span class="etichetta">
                {r.etichetta} <span class="freccia" aria-hidden="true">→</span>
              </span>
              <span class="titolo-lista testo-rimando"><span class="riga-punti">{r.testo}</span></span>
              {r.descrizione && <span class="descrizione">{r.descrizione}</span>}
            </a>
            {r.tutti && (
              <a class="etichetta tutti" href={r.tutti.href}>
                {r.tutti.etichetta} <span class="freccia" aria-hidden="true">→</span>
              </a>
            )}
          </li>
          ))
        )
      }
    </ul>
  </nav>
  <div class="nl"><Newsletter variante={variante} /></div>
</section>

<script>
  // Nei gruppi di alternative se ne accende una a caso, a ogni visita.
  const gruppi = new Map<string, HTMLElement[]>();
  for (const li of document.querySelectorAll<HTMLElement>('.chiusura li[data-gruppo]')) {
    const chiave = li.dataset.gruppo!;
    gruppi.set(chiave, [...(gruppi.get(chiave) ?? []), li]);
  }
  for (const righe of gruppi.values()) {
    const scelta = Math.floor(Math.random() * righe.length);
    righe.forEach((li, i) => (li.hidden = i !== scelta));
  }
</script>

<style>
  .chiusura {
    margin-top: var(--stacco);
    align-items: start;
  }
  .rimandi {
    grid-column: 1 / span 5;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--filetto);
  }
  li {
    position: relative;
    border-top: 1px solid var(--filetto);
  }
  .principale {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-10) 0;
    text-decoration: none;
  }
  .testo-rimando {
    color: var(--inchiostro-corpo);
  }
  .descrizione {
    font-size: var(--testo-piccolo);
    line-height: 1.5;
    color: var(--inchiostro-secondario);
  }
  /* «Vedi tutti» sulla riga dell'etichetta, a destra: un link a sé, fuori dalla riga principale */
  .tutti {
    position: absolute;
    top: var(--space-10);
    right: 0;
    text-decoration: none;
  }
  .tutti:hover {
    color: var(--inchiostro);
  }
  .nl {
    grid-column: 7 / span 6;
    display: flex;
  }
  .nl > :global(*) {
    flex: 1;
  }
  @media (max-width: 720px) {
    .chiusura {
      row-gap: var(--stacco);
    }
    .rimandi,
    .nl {
      grid-column: 1 / -1;
    }
    .principale {
      gap: var(--space-2);
      padding: var(--space-6) 0;
    }
    /* Bersaglio da 44px per il dito, centrato sulla riga dell'etichetta */
    .tutti {
      top: var(--space-3);
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
    }
  }
</style>
