---
// Lista degli scritti (design system, RigaScritto): titolo e data, righe separate dal filetto,
// posata sul fondo senza modulo. La usano anche i numeri della newsletter, con il mese al posto del giorno.
interface Props {
  articoli: { slug: string; titolo: string; data: Date; prima?: string }[];
  percorso?: string; // dove porta ogni riga: /chiacchiere/<slug>, /newsletter/<slug>
  formato?: 'giorno' | 'mese';
}
const { articoli, percorso = '/chiacchiere', formato = 'giorno' } = Astro.props;
const data = (d: Date) =>
  d.toLocaleDateString(
    'it-IT',
    formato === 'mese' ? { month: 'long', year: 'numeric' } : { day: 'numeric', month: 'long', year: 'numeric' }
  );
const iso = (d: Date) => d.toISOString().slice(0, formato === 'mese' ? 7 : 10);
---

<ol class="lista-scritti">
  {
    articoli.map((a) => (
      <li>
        <a href={`${percorso}/${a.slug}`}>
          <span class="titolo-lista"><span class="riga-punti">{a.titolo}</span></span>
          {a.prima ? (
            <span class="meta">
              {a.prima} · <time datetime={iso(a.data)}>{data(a.data)}</time>
            </span>
          ) : (
            <time class="meta" datetime={iso(a.data)}>{data(a.data)}</time>
          )}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .lista-scritti {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--filetto);
  }
  li {
    border-top: 1px solid var(--filetto);
  }
  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-10) 0;
    text-decoration: none;
  }
  .titolo-lista {
    color: var(--inchiostro-corpo);
  }
  .meta {
    flex-shrink: 0;
  }
  @media (max-width: 720px) {
    a {
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-6) 0;
    }
  }
</style>
