---
// Footer, dalle tavole: testi a sinistra, link e copyright a destra.
import { getMicrotesti, getNumeri } from '../cms';

const linkedin = 'https://www.linkedin.com/in/patriziobartolozzi';
const [{ footer }, numeri] = await Promise.all([getMicrotesti(), getNumeri()]);
// Newsletter porta all'archivio, che ha anche il modulo nella chiusura; finché non c'è un numero pubblicato, al modulo in home.
const newsletter = numeri.length > 0 ? '/newsletter' : '/#newsletter';
// L'anno della build: il sito si ricostruisce a ogni salvataggio, quindi resta sempre quello corrente.
const anno = new Date().getFullYear();
---

<footer class="footer">
  <div class="testi">
    <span><strong>dàretta.</strong> {footer.prima}</span>
    <span>{footer.seconda}</span>
  </div>
  <div class="link">
    <nav aria-label="Link del footer">
      <!-- Ogni link ha davanti il suo «·». Il nav sporge a sinistra di un «·» e del gap, e quella fascia è tagliata:
           così il punto che apre una riga non si vede mai, e nessuna riga finisce con un punto appeso -->
      <span class="voce"><span aria-hidden="true">·</span><a href="/curiosita">Curiosità</a></span>
      <span class="voce"><span aria-hidden="true">·</span><a href={newsletter}>Newsletter</a></span>
      <span class="voce"><span aria-hidden="true">·</span><a href={linkedin} rel="me noopener">LinkedIn</a></span>
      <span class="voce"><span aria-hidden="true">·</span><a href="mailto:dimmipure@daretta.it">Mail</a></span>
      <span class="voce"><span aria-hidden="true">·</span><a href="/privacy">Privacy</a></span>
    </nav>
    <span>© {anno} Patrizio Bartolozzi</span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-6) var(--rientro) var(--space-10);
    border-top: 1px solid var(--filetto-neutro);
    font-size: var(--testo-etichetta);
    line-height: 1.5;
    color: var(--inchiostro-muto);
  }
  .testi,
  .link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .link {
    align-items: flex-end;
  }
  strong {
    font-weight: 600;
    color: var(--inchiostro);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  nav {
    margin-left: calc(-1ch - var(--space-3));
    clip-path: inset(-12px -12px -12px calc(1ch + var(--space-3) - 6px));
    /* 6px di margine a sinistra: l'anello di focus del primo link di ogni riga resta intero */
  }
  .voce {
    display: inline-flex;
    gap: var(--space-3);
    white-space: nowrap;
  }
  .voce > span {
    width: 1ch;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    color: var(--inchiostro);
  }
  @media (max-width: 720px) {
    .footer {
      flex-direction: column;
      font-size: var(--testo-etichetta);
    }
    .link {
      align-items: flex-start;
    }
    /* Su touch i link devono essere alti almeno 44px */
    nav {
      gap: 0 var(--space-3);
    }
    nav a,
    .voce > span {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
