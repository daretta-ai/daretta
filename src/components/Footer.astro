---
// Footer, dalle tavole: testi a sinistra, link e copyright a destra.
import { getMicrotesti } from '../cms';

const linkedin = 'https://www.linkedin.com/in/patriziobartolozzi';
const { footer } = await getMicrotesti();
---

<footer class="footer">
  <div class="testi">
    <span><strong>dàretta.</strong> {footer.prima}</span>
    <span>{footer.seconda}</span>
  </div>
  <div class="link">
    <nav aria-label="Link del footer">
      <a href="/curiosita">Curiosità</a>
      <span aria-hidden="true">·</span>
      <a href="/#newsletter">Newsletter</a>
      <span aria-hidden="true">·</span>
      <a href={linkedin} rel="me noopener">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href="mailto:dimmipure@daretta.it">Mail</a>
      <span aria-hidden="true">·</span>
      <a href="/privacy">Privacy</a>
    </nav>
    <span>© 2026 Patrizio Bartolozzi</span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: 20px var(--space-2) var(--space-10);
    border-top: 1px solid var(--filetto-neutro);
    font-size: var(--testo-etichetta);
    line-height: 1.5;
    color: var(--inchiostro-muto);
  }
  .testi,
  .link {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .link {
    align-items: flex-end;
  }
  strong {
    font-weight: 600;
    color: var(--inchiostro);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    color: var(--inchiostro);
  }
  @media (max-width: 720px) {
    .footer {
      flex-direction: column;
      font-size: var(--testo-etichetta);
    }
    .link {
      align-items: flex-start;
    }
    /* Su touch i link devono essere alti almeno 44px */
    nav {
      gap: 0 var(--space-3);
    }
    nav a,
    nav span {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
