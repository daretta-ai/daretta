---
// Modulo: il box del sistema. La luce dice quanto petrolio prende dalla sfera.
// Gradienti copiati dalle tavole (design/tavole/).
//   forte    hero della home e testata delle pagine interne
//   media    Chi sono in home (luce da destra, centro fuori dal modulo)
//   sinistra modulo con il numero in Chi sono (luce da sinistra)
//   velo     Progetti in home
//   pieno    newsletter, l'unico modulo petrolio pieno
//   contorno card di rimando senza fondo
interface Props {
  luce?: 'forte' | 'media' | 'sinistra' | 'velo' | 'pieno' | 'contorno' | 'nessuna';
  as?: string;
  class?: string;
  [attr: string]: unknown;
}
const { luce = 'nessuna', as: Tag = 'section', class: classe, ...resto } = Astro.props;
---

<Tag class:list={['modulo', `luce-${luce}`, classe]} {...resto}>
  <slot />
</Tag>

<style>
  .modulo {
    position: relative;
    padding: var(--space-10);
    clip-path: var(--ritaglio-modulo);
    background: var(--cemento-rilievo);
  }
  .luce-forte {
    padding: var(--space-14);
    background: radial-gradient(760px 640px at 79% 50%, var(--petrolio-luce) 0%, #173134 45%, var(--cemento-rilievo) 85%);
  }
  .luce-media {
    background: radial-gradient(1000px 520px at 84% -12%, #1a444a 0%, #1a1f21 62%, var(--cemento-rilievo) 100%);
  }
  .luce-sinistra {
    padding: var(--space-14) 48px;
    background: radial-gradient(900px 520px at 12% 0%, #1a444a 0%, #1a1f21 60%, var(--cemento-rilievo) 100%);
  }
  .luce-velo {
    background: radial-gradient(1100px 420px at 92% -40%, #16292c 0%, var(--cemento-rilievo) 70%);
  }
  .luce-pieno {
    padding: 48px;
    background: linear-gradient(135deg, var(--petrolio-acceso) 0%, var(--petrolio-scuro) 100%);
    color: var(--carta);
  }
  /* Il contorno non può essere un border (il ritaglio lo taglierebbe sulle diagonali):
     è un fondo pieno con un foro smussato di 1px più in dentro. */
  .luce-contorno {
    background: var(--filetto-neutro);
  }
  .luce-contorno::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    background: var(--cemento);
    clip-path: polygon(0 calc(var(--modulo-smusso) - 0.6px), calc(var(--modulo-smusso) - 0.6px) 0, calc(100% - var(--modulo-smusso) + 0.6px) 0, 100% calc(var(--modulo-smusso) - 0.6px), 100% calc(100% - var(--modulo-smusso) + 0.6px), calc(100% - var(--modulo-smusso) + 0.6px) 100%, calc(var(--modulo-smusso) - 0.6px) 100%, 0 calc(100% - var(--modulo-smusso) + 0.6px));
  }
  .luce-contorno {
    isolation: isolate;
  }

  @media (max-width: 720px) {
    .modulo,
    .luce-forte,
    .luce-sinistra,
    .luce-pieno {
      padding: 28px var(--space-6) var(--space-8);
    }
    .luce-forte {
      background: radial-gradient(420px 360px at 80% 20%, var(--petrolio-luce) 0%, #173134 45%, var(--cemento-rilievo) 90%);
    }
    .luce-media,
    .luce-sinistra {
      background: radial-gradient(420px 320px at 10% 0%, #1a444a 0%, #1a1f21 60%, var(--cemento-rilievo) 100%);
    }
    .luce-velo {
      background: radial-gradient(400px 260px at 90% -20%, #16292c 0%, var(--cemento-rilievo) 70%);
    }
  }
</style>
