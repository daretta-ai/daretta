---
// Blocco con figura: etichetta nel margine (colonne 1–3), testo accanto (4–8), figura a destra (9–12).
// Su mobile: etichetta, testo, figura.
// La figura va nello slot "figura".
import Sezione from './Sezione.astro';

interface Props {
  numero: number;
  etichetta: string;
}
const { numero, etichetta } = Astro.props;
---

<section class="griglia blocco-figura">
  <Sezione numero={numero} cifre={2} class="margine">{etichetta}</Sezione>
  <div class="testo">
    <slot />
  </div>
  <div class="figura">
    <slot name="figura" />
  </div>
</section>

<style>
  .blocco-figura {
    align-items: start;
    padding: var(--space-18) var(--space-2) 0;
  }
  .blocco-figura :global(.margine) {
    grid-column: 1 / span 3;
    padding-top: var(--space-2);
  }
  .testo {
    grid-column: 4 / span 5;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .testo :global(p) {
    margin: 0;
    font-size: var(--testo-corpo);
    line-height: 1.7;
    color: var(--inchiostro-corpo);
  }
  .figura {
    grid-column: 9 / span 4;
  }
  /* La figura in colonna 12 arriva al filo destro dei contenuti, come i box a tutta larghezza */
  @media (min-width: 721px) {
    .figura {
      margin-right: calc(var(--space-2) * -1);
    }
  }
  @media (max-width: 720px) {
    .blocco-figura {
      padding: var(--space-8) var(--space-2) 0;
    }
    .blocco-figura {
      gap: var(--space-4);
    }
    .blocco-figura :global(.margine) {
      padding-top: 0;
    }
    .testo {
      gap: var(--space-4);
    }
    .testo :global(p) {
      font-size: var(--testo-corpo);
      line-height: 1.65;
    }
    .figura {
      margin: 0 calc(var(--space-2) * -1);
    }
  }
</style>
