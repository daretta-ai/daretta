---
// Blocco di testo lungo: etichetta nel margine (colonne 1–3), testo a destra (4–10).
// Su mobile l'etichetta si ripiega sopra il paragrafo.
import Sezione from './Sezione.astro';

interface Props {
  numero?: number;
  etichetta?: string; // senza etichetta: testo libero, senza numero
  spazio?: 'piccolo' | 'medio' | 'grande'; // distanza dal blocco prima: 48, 72, 88px
}
const { numero, etichetta, spazio = 'grande' } = Astro.props;
---

<section class:list={['griglia', 'blocco', `spazio-${spazio}`]}>
  {etichetta && <Sezione numero={numero} cifre={2} class="margine">{etichetta}</Sezione>}
  <div class="testo">
    <slot />
  </div>
</section>

<style>
  .blocco {
    align-items: start;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
  }
  .spazio-piccolo {
    padding-top: 48px;
  }
  .spazio-medio {
    padding-top: 72px;
  }
  .spazio-grande {
    padding-top: 88px;
  }
  .blocco :global(.margine) {
    grid-column: span 3;
    padding-top: 6px;
  }
  .testo {
    grid-column: 4 / span 7;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .testo :global(p) {
    margin: 0;
    font-size: 21px;
    line-height: 1.7;
    color: var(--inchiostro-corpo);
  }
  /* Gli elenchi del testo hanno il loro componente: Elenco.astro */
  @media (max-width: 720px) {
    .blocco {
      gap: 14px;
    }
    .spazio-piccolo,
    .spazio-medio {
      padding-top: var(--space-8);
    }
    .spazio-grande {
      padding-top: var(--space-10);
    }
    .blocco :global(.margine) {
      padding-top: 0;
    }
    .testo :global(p) {
      font-size: 18px;
      line-height: 1.65;
    }
  }
</style>
