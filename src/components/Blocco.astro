---
// Blocco di testo lungo: etichetta nel margine (colonne 1–3), testo al centro (4–9).
// Su mobile l'etichetta si ripiega sopra il paragrafo.
import Sezione from './Sezione.astro';

interface Props {
  etichetta?: string; // senza etichetta: testo libero
  spazio?: 'piccolo' | 'medio' | 'grande'; // distanza dal blocco prima: 48, 72, 88px
}
const { etichetta, spazio = 'grande' } = Astro.props;
---

<section class:list={['griglia', 'blocco', `spazio-${spazio}`]}>
  {etichetta && <Sezione segno class="margine">{etichetta}</Sezione>}
  <div class="testo">
    <slot />
  </div>
</section>

<style>
  .blocco {
    align-items: start;
    padding-left: var(--rientro);
    padding-right: var(--rientro);
  }
  .spazio-piccolo {
    padding-top: var(--space-10);
  }
  .spazio-medio {
    padding-top: var(--space-18);
  }
  .spazio-grande {
    padding-top: var(--space-24);
  }
  .blocco :global(.margine) {
    grid-column: span 3;
    padding-top: var(--space-2);
  }
  /* Se il testo comincia con un elenco, la prima riga sta sotto il margine dell'elenco (12px), il filetto e i 14px della voce:
     l'etichetta scende di altrettanto, così resta sulla prima riga di testo. Su mobile sta sopra, non serve. */
  @media (min-width: 721px) {
    .blocco:has(> .testo > :global(.elenco-testo:first-child)) :global(.margine) {
      padding-top: calc(var(--space-2) + var(--space-3) + 15px);
    }
  }
  .testo {
    grid-column: 4 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .testo :global(p) {
    margin: 0;
    font-size: var(--testo-corpo);
    line-height: 1.7;
    color: var(--inchiostro-corpo);
  }
  /* Gli elenchi del testo hanno il loro componente: Elenco.astro */
  @media (max-width: 720px) {
    .blocco {
      gap: var(--space-4);
    }
    .spazio-piccolo,
    .spazio-medio {
      padding-top: var(--space-8);
    }
    .spazio-grande {
      padding-top: var(--space-10);
    }
    .blocco :global(.margine) {
      padding-top: 0;
    }
    .testo :global(p) {
      font-size: var(--testo-corpo);
      line-height: 1.65;
    }
  }
</style>
