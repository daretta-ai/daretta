---
// Blocco con foto: etichetta nel margine (colonne 1–3), testo accanto (4–8), foto quadrata a destra (9–12).
// Tavola ChiSono, «Perché ora». Le foto stanno in public/foto, trattate con scripts/tratta-foto.py.
import Sezione from './Sezione.astro';

interface Props {
  numero: number;
  etichetta: string;
  foto: string; // nome del file senza misura: «notte» → notte-480.webp, notte-800.webp
  alt: string;
  posizione?: string; // object-position, per tenere il viso nel quadrato
}
const { numero, etichetta, foto, alt, posizione = '50% 50%' } = Astro.props;
---

<section class="griglia blocco-foto">
  <Sezione numero={numero} cifre={2} class="margine">{etichetta}</Sezione>
  <div class="testo">
    <slot />
  </div>
  <img
    class="foto"
    src={`/foto/${foto}-800.webp`}
    srcset={`/foto/${foto}-480.webp 480w, /foto/${foto}-800.webp 800w`}
    sizes="(max-width: 720px) 100vw, 33vw"
    width="800"
    height="800"
    alt={alt}
    loading="lazy"
    decoding="async"
    style={`object-position: ${posizione}`}
  />
</section>

<style>
  .blocco-foto {
    align-items: stretch;
    padding: var(--space-18) var(--space-2) 0;
  }
  .blocco-foto :global(.margine) {
    grid-column: 1 / span 3;
    padding-top: var(--space-2);
  }
  .testo {
    grid-column: 4 / span 5;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .testo :global(p) {
    margin: 0;
    font-size: var(--testo-corpo);
    line-height: 1.7;
    color: var(--inchiostro-corpo);
  }
  .foto {
    grid-column: 9 / span 4;
    clip-path: var(--ritaglio-modulo);
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    align-self: start;
    object-fit: cover;
    background: var(--cemento-alto);
  }
  /* La figura in colonna 12 arriva al filo destro dei contenuti, come i box a tutta larghezza */
  @media (min-width: 721px) {
    .foto {
      width: calc(100% + var(--space-2));
      max-width: none;
    }
  }
  @media (max-width: 720px) {
    .blocco-foto {
      padding-top: var(--space-8);
      gap: var(--space-4);
    }
    .blocco-foto :global(.margine) {
      padding-top: 0;
    }
    .testo {
      gap: var(--space-4);
    }
    .testo :global(p) {
      font-size: var(--testo-corpo);
      line-height: 1.65;
    }
    .foto {
      min-height: 360px;
    }
  }
</style>
