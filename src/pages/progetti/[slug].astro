---
// Pagina di un progetto (tavole Progetto*). Testata, corpo a blocchi e chiusura vengono da Keystatic.
import Base from '../../layouts/Base.astro';
import TestataProgetto from '../../components/TestataProgetto.astro';
import Corpo from '../../components/Corpo.astro';
import Chiusura from '../../components/Chiusura.astro';
import { rigaProgetto, ultimoScritto } from '../../rimandi';
import { progetto as schemaProgetto } from '../../dati-strutturati';
import { getProgetti, corpo, type Progetto } from '../../cms';

export async function getStaticPaths() {
  const progetti = await getProgetti();
  // Il prossimo progetto segue l'ordine della home; dopo l'ultimo si ricomincia dal primo.
  return progetti.map((progetto, i) => ({
    params: { slug: progetto.slug },
    props: { progetto, prossimo: progetti[(i + 1) % progetti.length] },
  }));
}

const { progetto, prossimo } = Astro.props as { progetto: Progetto; prossimo: Progetto };
const nodi = corpo(progetto.body, { stato: progetto.stato });

const rimandoProssimo = rigaProgetto(prossimo, 'Prossimo progetto');
---

<Base
  titolo={progetto.nome}
  descrizione={progetto.card}
  attiva="progetti"
  immagine={`/og/progetti/${progetto.slug}.png`}
  schema={schemaProgetto(progetto)}
>
  <TestataProgetto
    progetto={progetto}
    titolo={progetto.titolo}
    fase={progetto.fase}
    credito={progetto.credito}
    link={progetto.link}
  />

  <Corpo nodi={nodi} />

  <Chiusura rimandi={[rimandoProssimo, await ultimoScritto()]} />
</Base>
