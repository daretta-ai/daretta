---
// Progetti (approvata da Patrizio il 26 ottobre 2026): l'indice dei progetti. Testi in Keystatic, pagina Progetti.
// Testata, poi la lista posata sul fondo come le Chiacchiere (stato nel margine, nome e frase della card
// nella colonna del testo), poi il modulo con il numero che rompe il ritmo, poi la chiusura.
import Base from '../../layouts/Base.astro';
import Testata from '../../components/Testata.astro';
import Segno from '../../components/Segno.astro';
import Stato from '../../components/Stato.astro';
import ModuloNumero from '../../components/ModuloNumero.astro';
import Chiusura from '../../components/Chiusura.astro';
import { ultimoScritto, chiSono } from '../../rimandi';
import { aggiornatoA, getProgetti, getPaginaProgetti } from '../../cms';
import { linkInRiga } from '../../link-in-riga';
import { elenco, idProgetto } from '../../dati-strutturati';

const [progetti, testi] = await Promise.all([getProgetti(), getPaginaProgetti()]);
const descrizione = 'I side project di Patrizio Bartolozzi, portati avanti di notte.';
const con = (p: (typeof progetti)[number]) => p.collaboratori.map((c) => c.nome).join(' e ');
---

<Base
  titolo="Progetti"
  descrizione={descrizione}
  attiva="progetti"
  schema={elenco({ percorso: '/progetti', nome: 'Progetti', descrizione, parti: progetti.map((p) => idProgetto(p.slug)) })}
>
  <Testata titolo={testi.titolo}>
    <span slot="etichetta" class="etichetta"><Segno /><span class="etichetta-nome">Progetti</span></span>
    <p class="attacco" set:html={linkInRiga(testi.attacco)} />
  </Testata>

  <section class="griglia elenco">
    <ol class="lista-progetti">
      {
        progetti.map((p) => (
          <li>
            <a href={`/progetti/${p.slug}`} class="riga">
              <span class="margine">
                <Stato stato={p.stato} />
                {p.aggiornato && <span class="aggiornato">{aggiornatoA(p.aggiornato)}</span>}
              </span>
              <span class="testo">
                <span class="nome" data-titolo-vola>
                  <span class="riga-punti">{p.nome}</span>
                  {p.provvisorio && <span class="provvisorio">(nome provvisorio)</span>}
                </span>
                <span class="frase">{p.card}</span>
                {p.collaboratori.length > 0 && <span class="con">Con {con(p)}</span>}
              </span>
              <span class="vai" aria-hidden="true">
                <span class="freccia">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <ModuloNumero etichetta={testi.numeroEtichetta} cifra={String(progetti.length)} didascalia={testi.numeroDidascalia}>
    <p set:html={linkInRiga(testi.numeroTesto)} />
  </ModuloNumero>

  <Chiusura rimandi={[await ultimoScritto(), chiSono]} />
</Base>

<style>
  .attacco {
    margin: 0;
    max-width: 680px;
    font-size: var(--testo-attacco);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.5px;
  }
  .elenco {
    padding: var(--space-18) var(--rientro) 0;
  }
  .lista-progetti {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--filetto);
  }
  li {
    border-top: 1px solid var(--filetto);
  }
  .riga {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    padding: var(--space-10) 0;
    text-decoration: none;
    color: inherit;
  }
  .margine {
    grid-column: 1 / span 3;
    padding-top: var(--space-2);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .aggiornato {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .testo {
    grid-column: 4 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .nome {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--testo-titolo);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  .provvisorio,
  .con {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .frase {
    font-size: var(--testo-corpo);
    line-height: 1.5;
    color: var(--inchiostro-corpo);
  }
  .vai {
    grid-column: 12;
    justify-self: end;
    padding-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--testo-etichetta);
    color: var(--inchiostro-muto);
  }
  @media (max-width: 720px) {
    .elenco {
      padding-top: var(--space-8);
    }
    .riga {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-6) 0;
    }
    .nome {
      font-size: var(--testo-titolo);
    }
    .vai {
      display: none;
    }
  }
</style>
