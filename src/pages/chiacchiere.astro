---
// Chiacchiere (tavola Scritti). Finché non c'è un articolo pubblicato, la pagina dice che arriva.
import Base from '../layouts/Base.astro';
import Testata from '../components/Testata.astro';
import Segno from '../components/Segno.astro';
import ListaScritti from '../components/ListaScritti.astro';
import Chiusura from '../components/Chiusura.astro';
import { progetto, chiSono } from '../rimandi';
import { getArticoli, getMicrotesti } from '../cms';

const [articoli, micro] = await Promise.all([getArticoli(), getMicrotesti()]);
const vuoto = articoli.length === 0;
---

<Base
  titolo="Chiacchiere"
  descrizione={vuoto ? 'Gli articoli di Patrizio Bartolozzi. Il primo arriva presto.' : 'Gli articoli di Patrizio Bartolozzi.'}
  attiva="chiacchiere"
>
  <Testata titolo="quattro chiacchiere.">
    <span slot="etichetta" class="etichetta"><Segno /><span class="etichetta-nome">Chiacchiere</span></span>
    {vuoto && <p class="attacco">{micro.scrittiVuoto}</p>}
  </Testata>

  {
    !vuoto && (
      <section class="griglia elenco">
        <div class="colonna">
          <ListaScritti articoli={articoli} />
        </div>
      </section>
    )
  }

  <Chiusura rimandi={[await progetto(), chiSono]} />
</Base>

<style>
  .attacco {
    margin: 0;
    max-width: 680px;
    font-size: var(--testo-attacco);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.5px;
  }
  .elenco {
    padding: var(--space-18) var(--space-2) 0;
  }
  .colonna {
    grid-column: 1 / span 10;
  }
  @media (max-width: 720px) {
    .attacco {
      font-size: var(--testo-attacco);
      line-height: 1.35;
    }
    .elenco {
      padding-top: var(--space-8);
    }
  }
</style>
