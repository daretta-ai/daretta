---
// Scritti, finché è vuoto (tavola Scritti).
import Base from '../layouts/Base.astro';
import Testata from '../components/Testata.astro';
import Chiusura from '../components/Chiusura.astro';
---

<Base titolo="Scritti" descrizione="Gli articoli di Patrizio Bartolozzi. Il primo arriva presto." attiva="scritti">
  <Testata titolo="scritti.">
    <span slot="etichetta" class="etichetta">[ 003 ] Scritti</span>
    <p class="attacco">Ancora niente. Il primo articolo arriva presto… l'ho promesso all'AI.</p>
  </Testata>

  <Chiusura
    rimandi={[
      { etichetta: '[ 004 ] Progetti', testo: 'Quello che porto avanti la sera.', href: '/#progetti' },
      { etichetta: '[ 005 ] Curiosità', testo: 'Il resto, quello che non va nel curriculum.', href: '/curiosita' },
    ]}
  />
</Base>

<style>
  .attacco {
    margin: 0;
    max-width: 680px;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.5px;
  }
  @media (max-width: 720px) {
    .attacco {
      font-size: 21px;
      line-height: 1.35;
    }
  }
</style>
