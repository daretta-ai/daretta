---
// Pagina 404 (tavole Pagina404 e Pagina404-Mobile, microtesti approvati).
import Base from '../layouts/Base.astro';
import Testata from '../components/Testata.astro';
import Tabellone from '../components/Tabellone.astro';
---

<Base titolo="Pagina non trovata">
  <Testata titolo="qui non c'è niente.">
    <span slot="etichetta" class="etichetta">[ 404 ] Pagina non trovata</span>
    <p class="attacco">
      O c'era e l'ho tolta, o il link è sbagliato. Ma se proprio vuoi restare, ti do qualche curiosità su di me.
    </p>
  </Testata>

  <section class="griglia resto">
    <div class="colonna">
      <Tabellone />
      <p class="via">Altrimenti… <a href="/">torna al via</a>.</p>
    </div>
  </section>
</Base>

<style>
  .attacco {
    margin: 0;
    max-width: 680px;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.5px;
  }
  .resto {
    padding: 72px var(--space-2) 0;
  }
  .colonna {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .via {
    margin: 0;
    font-size: 21px;
    line-height: 1.6;
    color: var(--inchiostro-corpo);
  }
  .via a {
    color: var(--inchiostro);
    text-decoration-style: dotted;
    text-underline-offset: 4px;
  }
  @media (max-width: 1100px) {
    .colonna {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .attacco {
      font-size: 21px;
      line-height: 1.35;
    }
    .resto {
      padding-top: var(--space-10);
    }
    .via {
      font-size: 18px;
    }
  }
</style>
