---
// Home, dalle tavole Main (desktop) e Home-Mobile.
import Base from '../layouts/Base.astro';
import Modulo from '../components/Modulo.astro';
import Sezione from '../components/Sezione.astro';
import Stato from '../components/Stato.astro';
import CardProgetto from '../components/CardProgetto.astro';
import Newsletter from '../components/Newsletter.astro';
import Sfera from '../components/Sfera.astro';
import Tabellone from '../components/Tabellone.astro';
import { progetti } from '../data/progetti';
---

<Base home>
  <!-- Hero -->
  <Modulo luce="forte" class="griglia hero" data-hero>
    <div class="hero-testo">
      <h1 class="logo">d<span>à</span>retta</h1>
      <p class="motto">risolvo problemi, a volte sono intere aziende.</p>
      <p class="presentazione">
        Sono amministratore delegato di Codever e service leader dello sviluppo digital di Mirror. Qui racconto i
        side project che porto avanti la sera, e condivido con voi un po' di me.
      </p>
      <a class="cta-hero" href="#newsletter">Una mail al mese →</a>
    </div>
    <div class="hero-sfera">
      <Sfera />
    </div>
  </Modulo>

  <!-- Chi sono -->
  <Modulo luce="media" class="griglia chi-sono">
    <div class="chi-sinistra">
      <Sezione numero={2}>Chi sono</Sezione>
      <p class="titolo-modulo">
        Sviluppatore, team leader, project manager, product manager, CEO. Non è ambizione, è che ogni volta il
        problema stava uno scalino più su.
      </p>
    </div>
    <div class="chi-destra">
      <p class="breve">
        La versione breve è che ho un'azienda di software a Firenze. Per i più curiosi, l'azienda si chiama Codever,
        l'ho fondata con Alberto e ne sono amministratore delegato. Siamo system integrator specializzati in sviluppo
        web e mobile, con il pallino per le prestazioni. Dal 2026 facciamo parte di Mirror, dove sono service leader
        dello sviluppo digital e system administrator. Se sono a una cena, però, mi fermo alla versione breve, perché
        dopo «service leader» nessuno mi passa più il vino.
      </p>
      <a class="link-etichetta" href="/chi-sono">Tutta la storia →</a>
    </div>
  </Modulo>

  <!-- Scritti e foto -->
  <section class="griglia scritti-foto">
    <div class="scritti">
      <Sezione numero={3}>Scritti</Sezione>
      <p class="titolo-lista vuoto">Ancora niente. Il primo articolo arriva presto… l'ho promesso all'AI.</p>
    </div>
    <img class="foto" src="/foto/pini-800.webp" srcset="/foto/pini-480.webp 480w, /foto/pini-800.webp 800w" sizes="(max-width: 720px) 100vw, 33vw" width="800" height="800" alt="Patrizio con gli occhiali da sole, davanti al mare e ai pini" loading="lazy" decoding="async" style="object-position: 50% 40%" />
  </section>

  <!-- Progetti -->
  <Modulo luce="velo" class="progetti" id="progetti">
    <div class="progetti-testa">
      <Sezione numero={4}>Progetti</Sezione>
      <div class="legenda" aria-hidden="true">
        <Stato stato="online" frase={false} />
        <Stato stato="in-sviluppo" frase={false} />
        <Stato stato="concept" frase={false} />
      </div>
    </div>
    <div class="card">
      {progetti.map((p) => <CardProgetto progetto={p} />)}
    </div>
  </Modulo>

  <!-- Curiosità e newsletter -->
  <section class="griglia curiosita-newsletter">
    <div class="curiosita">
      <div class="curiosita-testa">
        <Sezione numero={5}>Curiosità</Sezione>
        <a class="link-etichetta" href="/curiosita">Vedi tutte →</a>
      </div>
      <Tabellone />
    </div>
    <div class="nl-home"><Newsletter /></div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    min-height: 780px;
    align-items: center;
  }
  .hero-testo {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero-sfera {
    grid-column: span 5;
    display: flex;
    justify-content: center;
  }
  .logo {
    margin: 0;
    font-family: var(--font-punti);
    font-weight: 900;
    font-size: 136px;
    line-height: 0.9;
    letter-spacing: -4px;
  }
  .logo span {
    color: var(--arancio);
  }
  .motto {
    margin: 0;
    font-family: var(--font-punti);
    font-weight: 900;
    font-size: 48px;
    line-height: 1.05;
    letter-spacing: -1px;
    text-wrap: balance;
  }
  .presentazione {
    margin: 0;
    max-width: 620px;
    font-size: 24px;
    line-height: 1.45;
    color: var(--inchiostro-corpo);
  }
  .cta-hero {
    align-self: flex-start;
    display: flex;
    align-items: center;
    height: 56px;
    padding: 0 28px;
    border-radius: var(--radius-pill);
    background: var(--arancio);
    color: var(--cemento);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Chi sono */
  .chi-sono {
    align-items: start;
  }
  .chi-sinistra {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .chi-destra {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 38px;
  }
  .breve {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--inchiostro-corpo);
  }
  .link-etichetta {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--inchiostro-muto);
  }
  .link-etichetta:hover {
    color: var(--inchiostro);
  }

  /* Scritti e foto */
  .scritti-foto {
    padding-top: var(--space-8);
  }
  .scritti {
    grid-column: span 8;
    padding: var(--space-2) var(--space-2) 0;
  }
  .scritti :global(.etichetta) {
    padding-bottom: 20px;
  }
  .vuoto {
    padding: 40px 0;
    border-top: 1px solid var(--filetto);
    border-bottom: 1px solid var(--filetto);
    color: var(--inchiostro-corpo);
  }
  .foto {
    grid-column: span 4;
    min-height: 460px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-modulo);
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    min-height: 0;
    align-self: start;
    object-fit: cover;
    background: var(--cemento-alto);
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }

  /* Progetti */
  .progetti {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .progetti-testa,
  .curiosita-testa {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .legenda {
    display: flex;
    gap: 20px;
  }
  .card {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  /* Curiosità e newsletter */
  .curiosita-newsletter {
    padding-top: var(--space-8);
  }
  .curiosita {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-2) var(--space-2) 0;
  }
  .nl-home {
    grid-column: 7 / span 6;
    display: flex;
  }
  .nl-home > :global(*) {
    flex: 1;
  }

  /* Tablet: la griglia si stringe */
  @media (max-width: 1200px) {
    .card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .curiosita,
    .nl-home {
      grid-column: 1 / -1;
    }
    .logo {
      font-size: 104px;
    }
  }

  /* Mobile, dalla tavola Home-Mobile */
  @media (max-width: 720px) {
    .hero {
      min-height: 0;
      gap: 20px;
    }
    .hero-testo {
      display: contents;
    }
    .logo {
      font-size: 72px;
      letter-spacing: -2px;
    }
    .motto {
      font-size: 34px;
      line-height: 1.08;
    }
    .hero-sfera {
      order: 3;
    }
    .hero-sfera :global(.sfera) {
      width: 300px;
    }
    .presentazione {
      order: 4;
      font-size: 19px;
    }
    .cta-hero {
      order: 5;
      align-self: stretch;
      justify-content: center;
      height: 52px;
    }
    .chi-destra .breve {
      display: none;
    }
    .chi-destra {
      padding-top: 0;
    }
    .link-etichetta {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-size: 12px;
    }
    .scritti-foto,
    .curiosita-newsletter {
      padding-top: var(--space-4);
    }
    .scritti {
      padding: var(--space-3) var(--space-3) 0;
    }
    .vuoto {
      padding: 20px 0;
      font-size: 22px;
      line-height: 1.3;
    }
    .foto {
      min-height: 300px;
      border-radius: var(--radius-modulo-mobile);
    }
    .progetti {
      gap: var(--space-3);
    }
    .progetti-testa {
      flex-direction: column;
      gap: var(--space-3);
    }
    .legenda {
      gap: var(--space-3);
    }
    .card {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
    .curiosita {
      padding: var(--space-4) 0;
    }
    .curiosita-testa {
      padding: 0 var(--space-3);
    }
  }
</style>
