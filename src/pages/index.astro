---
// Pagina provvisoria: mostra i componenti base (passo 2 del piano).
// La home vera arriva al passo 3.
import Base from '../layouts/Base.astro';
import Modulo from '../components/Modulo.astro';
import Stato from '../components/Stato.astro';
import Sezione from '../components/Sezione.astro';
import { getCollection } from 'astro:content';

const curiosita = await getCollection('curiosita');
---

<Base>
  <div class="pagina vetrina">
    <Modulo luce="forte" class="griglia hero">
      <div class="testo-hero">
        <p class="logo">d<span>à</span>retta</p>
        <p class="motto">risolvo problemi, a volte sono intere aziende.</p>
      </div>
    </Modulo>

    <div class="griglia">
      <Modulo luce="media" class="meta">
        <Sezione numero={1}>Modulo, luce media</Sezione>
        <p>Chi sono prende una dose media di petrolio.</p>
      </Modulo>
      <Modulo luce="velo" class="meta">
        <Sezione numero={2}>Modulo, un velo</Sezione>
        <p>Progetti ne prende appena un velo.</p>
      </Modulo>
    </div>

    <section>
      <Sezione numero={3}>Stati dei progetti</Sezione>
      <ul class="stati">
        <li><Stato stato="online" /></li>
        <li><Stato stato="in-sviluppo" /></li>
        <li><Stato stato="concept" /></li>
      </ul>
    </section>

    <Modulo luce="pieno" id="newsletter">
      <Sezione numero={4}>Newsletter</Sezione>
      <p class="titolo-pagina">una mail al mese.</p>
    </Modulo>

    <p class="nota">Scheletro in anteprima · {curiosita.length} curiosità caricate</p>
  </div>
</Base>

<style>
  .vetrina {
    display: grid;
    gap: var(--gap);
    padding-top: var(--space-3);
  }
  .hero {
    min-height: 60vh;
    align-items: center;
  }
  .testo-hero {
    grid-column: 1 / 9;
  }
  .logo {
    margin: 0;
    font-family: var(--punti);
    font-weight: 900;
    font-size: var(--punti-hero);
    line-height: 1;
  }
  .logo span {
    color: var(--arancio);
  }
  .motto {
    margin: var(--space-3) 0 0;
    font-family: var(--punti);
    font-weight: 800;
    font-size: var(--punti-motto);
    line-height: 1.1;
  }
  .meta {
    grid-column: span 6;
  }
  .meta p {
    margin: 0;
    color: var(--inchiostro-corpo);
  }
  .stati {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nota {
    font-family: var(--mono);
    font-size: 13px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
</style>
