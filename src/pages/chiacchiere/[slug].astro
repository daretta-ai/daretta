---
// Un articolo (tavola Articolo): colonna di lettura sul fondo, metadati nel margine,
// barra di avanzamento a punti sotto l'header, in fondo la chiusura (prossimo articolo, progetti, newsletter).
import Base from '../../layouts/Base.astro';
import Corpo from '../../components/Corpo.astro';
import Chiusura from '../../components/Chiusura.astro';
import { progetto, tuttiGliScritti } from '../../rimandi';
import Apertura from '../../components/Apertura.astro';
import Firma from '../../components/Firma.astro';
import { articolo as schemaArticolo } from '../../dati-strutturati';
import { getArticoli, corpo, minutiDiLettura } from '../../cms';

export async function getStaticPaths() {
  const articoli = await getArticoli();
  // Il prossimo da leggere è quello uscito prima; dopo il più vecchio, si torna all'elenco.
  return articoli.map((articolo, i) => ({
    params: { slug: articolo.slug },
    props: { articolo, prossimo: articoli[i + 1] },
  }));
}

type Articolo = Awaited<ReturnType<typeof getArticoli>>[number];
const { articolo, prossimo } = Astro.props as { articolo: Articolo; prossimo?: Articolo };
const nodi = corpo(articolo.body);
---

<Base
  titolo={articolo.titolo}
  descrizione={articolo.attacco}
  attiva="chiacchiere"
  avanzamento
  articolo={{ data: articolo.data }}
  immagine={`/og/chiacchiere/${articolo.slug}.png`}
  schema={schemaArticolo(articolo)}
>
  <article class="articolo" data-articolo>
    <Apertura
      torna={{ href: '/chiacchiere', testo: 'Chiacchiere' }}
      tag={articolo.tag}
      data={articolo.data}
      minuti={minutiDiLettura(articolo.body)}
      titolo={articolo.titolo}
      attacco={articolo.attacco}
    />

    <Corpo nodi={nodi} />

    <Firma />
  </article>

  <Chiusura
    variante="articolo"
    rimandi={[
      prossimo ? { etichetta: 'Prossimo', testo: prossimo.titolo, href: `/chiacchiere/${prossimo.slug}` } : tuttiGliScritti,
      await progetto(),
    ]}
  />
</Base>

<style>
  .articolo {
    display: flex;
    flex-direction: column;
  }
</style>
