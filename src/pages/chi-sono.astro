---
// Chi sono (tavole ChiSono e ChiSono-Mobile). I testi vengono da Keystatic (pagina «Chi sono»).
import Base from '../layouts/Base.astro';
import Testata from '../components/Testata.astro';
import Sezione from '../components/Sezione.astro';
import Blocco from '../components/Blocco.astro';
import Corpo from '../components/Corpo.astro';
import Chiusura from '../components/Chiusura.astro';
import { getChiSono, corpo } from '../cms';
import { paginaProfilo } from '../dati-strutturati';

const pagina = await getChiSono();

// La scala dei ruoli: ogni gradino è più alto e più acceso del precedente.
// Con cinque gradini i colori sono quelli della tavola; con un numero diverso si sfumano tra il primo e l'ultimo.
const tavola = ['#1f4a50', '#235a61', '#276b73', '#2c7c84', '#3a9ca5'];
const sfuma = (i: number, n: number) => {
  if (n === tavola.length) return tavola[i];
  const t = n > 1 ? i / (n - 1) : 1;
  const a = [0x1f, 0x4a, 0x50], b = [0x3a, 0x9c, 0xa5];
  return '#' + a.map((x, k) => Math.round(x + (b[k] - x) * t).toString(16).padStart(2, '0')).join('');
};
const ruoli = pagina.ruoli.map((nome, i, tutti) => ({ nome, colore: sfuma(i, tutti.length) }));
const passo = 100 / Math.max(ruoli.length, 1);

// La versione breve è il blocco 01; il resto del corpo continua da 02.
const nodi = corpo(pagina.body, { inizio: 2 });
---

<Base titolo="Chi sono" descrizione={pagina.attacco} attiva="chi-sono" schema={paginaProfilo}>
  <Testata titolo={pagina.titolo}>
    <span slot="etichetta" class="etichetta">[ 002 ] Chi sono</span>
    <p class="attacco">{pagina.attacco}</p>
  </Testata>

  <section class="percorso">
    <Sezione>Il percorso</Sezione>
    <ol style={`--gradini: ${ruoli.length}`}>
      {
        ruoli.map((r, i) => (
          <li style={`--h: ${(i + 1) * 64}px; --w: ${Math.round((i + 1) * passo)}%; --c: ${r.colore}`}>
            <span class:list={['ruolo', { ultimo: i === ruoli.length - 1 }]}>
              {String(i + 1).padStart(2, '0')} · {r.nome}
            </span>
            <span class="gradino" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
  </section>

  <Blocco numero={1} etichetta="La versione breve" spazio="piccolo">
    <p>{pagina.breve}</p>
  </Blocco>

  <Corpo nodi={nodi} />

  <Chiusura
    rimandi={[
      { etichetta: '[ 004 ] Progetti', testo: 'Quello che porto avanti la sera.', href: '/#progetti' },
      { etichetta: '[ 005 ] Curiosità', testo: 'Il resto, quello che non va nel curriculum.', href: '/curiosita' },
    ]}
  />
</Base>

<style>
  .attacco {
    margin: 0;
    max-width: 680px;
    font-size: var(--testo-attacco);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.5px;
  }

  .percorso {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: 72px var(--space-2) var(--space-6);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--gradini, 5), minmax(0, 1fr));
    gap: var(--space-3);
    align-items: end;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ruolo {
    font-family: var(--font-mono);
    font-size: var(--testo-meta);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }
  .ruolo.ultimo {
    color: var(--inchiostro);
  }
  .gradino {
    height: var(--h);
    clip-path: var(--ritaglio-campo);
    background-color: var(--cemento-rilievo);
    background-image: radial-gradient(circle, var(--c) 1.8px, transparent 2.3px);
    background-size: 12px 12px;
  }


  @media (max-width: 720px) {
    .attacco {
      font-size: var(--testo-attacco);
      line-height: 1.35;
    }
    .percorso {
      padding: var(--space-10) var(--space-2) var(--space-2);
      gap: 20px;
    }
    /* Su mobile la scala si sdraia: barre orizzontali sempre più lunghe */
    ol {
      display: flex;
      flex-direction: column;
      align-items: stretch; /* il desktop allinea i gradini in basso (end): qui li manderebbe a destra */
      gap: var(--space-2);
    }
    li {
      gap: 6px;
    }
    .ruolo {
      font-size: var(--testo-meta);
    }
    .gradino {
      width: var(--w);
      height: 28px;
      background-image: radial-gradient(circle, var(--c) 1.6px, transparent 2.1px);
      background-size: 10px 10px;
    }
  }
</style>
