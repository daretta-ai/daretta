---
import '../styles/token.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ANTEPRIMA } from '../sito';

interface Props {
  titolo?: string;
  descrizione?: string;
  attiva?: 'scritti' | 'progetti' | 'chi-sono';
  home?: boolean;
  avanzamento?: boolean;
}

const {
  titolo,
  descrizione = 'Il sito di Patrizio Bartolozzi. Risolvo problemi, a volte sono intere aziende.',
  attiva,
  home = false,
  avanzamento = false,
} = Astro.props;

const titoloCompleto = titolo ? `${titolo} · dàretta` : 'dàretta';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    {ANTEPRIMA && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#111314" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Doto:wght@600;800;900&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="salta smussato" href="#contenuto">Vai al contenuto</a>
    <div class="pagina">
      <Header attiva={attiva} home={home} avanzamento={avanzamento} />
      <main id="contenuto" class="contenuto">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .contenuto {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .salta {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 30;
    padding: var(--space-2) var(--space-4);
    --h: 36px;
    --fondo: var(--inchiostro);
    color: var(--cemento);
  }
  .salta:focus {
    top: var(--space-4);
  }
</style>
