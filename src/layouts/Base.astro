---
import '../styles/font.css';
import '../styles/token.css';
import '../styles/movimento.css';
import geistTesto from '../assets/font/geist-sans-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ANTEPRIMA } from '../sito';
import { grafo } from '../dati-strutturati';

interface Props {
  titolo?: string;
  descrizione?: string;
  attiva?: 'scritti' | 'progetti' | 'chi-sono';
  home?: boolean;
  avanzamento?: boolean;
  // Pagine da non far trovare ai motori anche dopo il lancio (404, conferma newsletter)
  nascosta?: boolean;
  // Per gli articoli: og:type «article» con la data di pubblicazione
  articolo?: { data: Date };
  // Immagine di anteprima per i social (1200×630), generata da src/pages/og. Di base quella del sito.
  immagine?: string;
  // Nodo schema.org della pagina (articolo, progetto), da src/dati-strutturati.ts
  schema?: Record<string, unknown>;
}

const {
  titolo,
  descrizione = 'Il sito di Patrizio Bartolozzi. Risolvo problemi. Di solito non i miei. Qui racconto i side project che porto avanti la sera.',
  attiva,
  home = false,
  avanzamento = false,
  nascosta = false,
  articolo,
  immagine = '/og/sito.png',
  schema,
} = Astro.props;

const titoloCompleto = titolo ? `${titolo} · dàretta` : 'dàretta';
// Indirizzo canonico sempre su daretta.it, anche quando la pagina è servita dall'anteprima
// Le pagine sono file .html (build.format 'file'), ma si servono senza estensione: /chi-sono, e / per la home.
const percorso = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const canonico = new URL(percorso, Astro.site).href;
const immagineAssoluta = new URL(immagine, Astro.site).href;

// Dati strutturati (src/dati-strutturati.ts): in home chi è Patrizio e qual è il suo sito;
// articoli e progetti passano il proprio nodo, che si aggiunge a quei due.
const datiStrutturati = schema ? grafo(schema) : home ? grafo() : null;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    {(ANTEPRIMA || nascosta) && <meta name="robots" content="noindex, nofollow" />}
    {!nascosta && <link rel="canonical" href={canonico} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="dàretta · Scritti" href="/rss.xml" />
    <meta property="og:site_name" content="dàretta" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={articolo ? 'article' : 'website'} />
    <meta property="og:title" content={titolo ?? 'dàretta'} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonico} />
    {articolo && <meta property="article:published_time" content={articolo.data.toISOString()} />}
    {articolo && <meta property="article:author" content="Patrizio Bartolozzi" />}
    <meta name="author" content="Patrizio Bartolozzi" />
    <meta property="og:image" content={immagineAssoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titolo ? `${titolo} · dàretta` : 'dàretta'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#111314" />
    <!-- Doto pesa meno di 4 KB per peso: Vite la incorpora nel CSS, non serve precaricarla -->
    <link rel="preload" href={geistTesto} as="font" type="font/woff2" crossorigin />
    {datiStrutturati && <script type="application/ld+json" set:html={datiStrutturati} />}
    <script is:inline>
      // Passaggio tra le pagine: la sfera vola dalla pagina vecchia alla nuova solo se si vede in tutte e due.
      // Se al clic è fuori dallo schermo (es. dai Progetti in home) non le si dà il nome:
      // niente sfera che cala dall'alto, la pagina sfuma e basta. In linea nell'head perché pagereveal
      // arriva prima che partano gli script normali.
      (function () {
        var CHIAVE = 'sfera-ferma';
        var inVista = function (el) {
          var r = el.getBoundingClientRect();
          return r.width > 0 && r.bottom > 0 && r.top < innerHeight;
        };
        var nome = function (valore) {
          document.querySelectorAll('[data-sfera]').forEach(function (el) {
            el.style.viewTransitionName = valore;
          });
        };
        var togli = function () { nome('none'); };
        // Finito il passaggio la sfera riprende il nome, per il prossimo clic
        var rimetti = function () { nome(''); };
        addEventListener('pageswap', function (e) {
          if (!e.viewTransition) return;
          var sfera = document.querySelector('[data-sfera]');
          if (sfera && inVista(sfera)) return;
          togli();
          try { sessionStorage.setItem(CHIAVE, '1'); } catch (_) {}
        });
        addEventListener('pagereveal', function (e) {
          var ferma = false;
          try { ferma = sessionStorage.getItem(CHIAVE) === '1'; sessionStorage.removeItem(CHIAVE); } catch (_) {}
          if (!e.viewTransition) return;
          var sfera = document.querySelector('[data-sfera]');
          if (ferma || (sfera && !inVista(sfera))) {
            togli();
            e.viewTransition.finished.then(rimetti, rimetti);
          }
        });
        // Tornando indietro la pagina può uscire intatta dalla cache, con la sfera ancora senza nome
        addEventListener('pageshow', function (e) {
          if (e.persisted) rimetti();
        });
      })();
      // Segni degli elenchi: si nascondono prima del primo disegno, così si vedono aprirsi
      // (lo script in fondo alla pagina li accende). Solo se il movimento si può fare:
      // niente con prefers-reduced-motion, arrivando da un'ancora o tornando indietro.
      (function () {
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          if (
            matchMedia('(prefers-reduced-motion: reduce)').matches ||
            location.hash ||
            (nav && nav.type === 'back_forward') ||
            !('IntersectionObserver' in window)
          ) return;
          document.documentElement.setAttribute('data-segni', 'attesa');
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="salta smussato" href="#contenuto">Vai al contenuto</a>
    <div class="pagina">
      <Header attiva={attiva} home={home} avanzamento={avanzamento} />
      <main id="contenuto" class="contenuto">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // Moduli sotto la piega: salgono appena quando entrano nello schermo, una volta sola.
      // Solo i blocchi di pagina (moduli, figure, foto, citazioni, chiusura), mai i paragrafi:
      // restano fuori la testata, i blocchi di testo e tutto l'articolo.
      // Niente animazione se si arriva da un'ancora (#013) o tornando indietro, dove la pagina
      // si apre già scorsa, e con prefers-reduced-motion.
      const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const navigazione = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const indietro = navigazione?.type === 'back_forward';
      if (!ridotto && !location.hash && !indietro && 'IntersectionObserver' in window) {
        const sotto = [...document.querySelectorAll<HTMLElement>('main > *:not(:first-child):not(.blocco):not(article)')]
          .filter((el) => el.getBoundingClientRect().top > innerHeight);
        const osserva = new IntersectionObserver(
          (voci) => {
            for (const v of voci) {
              if (!v.isIntersecting) continue;
              v.target.classList.add('rivelato');
              osserva.unobserve(v.target);
            }
          },
          { rootMargin: '0px 0px -6% 0px' },
        );
        for (const el of sotto) {
          el.classList.add('da-rivelare');
          osserva.observe(el);
        }
      }

      // Segni degli elenchi: si aprono quando l'elenco entra nello schermo, una volta sola.
      // Lo stato di attesa lo mette lo script nell'head, con le stesse condizioni di sopra.
      if (document.documentElement.dataset.segni === 'attesa') {
        const segni = new IntersectionObserver(
          (voci) => {
            for (const v of voci) {
              if (!v.isIntersecting) continue;
              v.target.classList.add('visto');
              segni.unobserve(v.target);
            }
          },
          { rootMargin: '0px 0px -6% 0px' },
        );
        document.querySelectorAll('.elenco-testo').forEach((el) => segni.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .contenuto {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .salta {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 30;
    padding: var(--space-2) var(--space-4);
    --h: 36px;
    --fondo: var(--inchiostro);
    color: var(--cemento);
  }
  .salta:focus {
    top: var(--space-4);
  }
</style>
